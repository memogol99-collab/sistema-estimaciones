(defun xyzt:get (key cfg) (cdr (assoc key cfg)))
(defun xyzt:put (key val cfg / a)
  (if (setq a (assoc key cfg)) (subst (cons key val) a cfg)
    (cons (cons key val) cfg)))
(defun xyzt:trim (s) (vl-string-trim (strcat " " (chr 9) (chr 13) (chr 10)) s))
(defun xyzt:fail (s) (setq *xyzt:failure* (strcat "IXYZ: " s)) (exit))
(defun xyzt:try (fn args) (setq *xyzt:failure* nil) (vl-catch-all-apply fn args))
(defun xyzt:errmsg (err) (if *xyzt:failure* *xyzt:failure* (vl-catch-all-error-message err)))
(defun xyzt:make (data / en)
  (if (entmake data) (entlast) (xyzt:fail "No se pudo crear una entidad grafica.")))
(defun xyzt:nstr (v / old out)
  (setq old (getvar "DIMZIN"))
  (setvar "DIMZIN" 0)
  (setq out (rtos v 2 8))
  (setvar "DIMZIN" old)
  out)
(defun xyzt:floor (v / n)
  (if (> (abs v) 2147483000.0)
    (setq n (atof (rtos (- v (rem v 1.0)) 2 0)))
    (setq n (fix v)))
  (if (< v n) (- n 1) n))
(defun xyzt:hex (rgb / out digits n)
  (setq digits "0123456789ABCDEF" out "#")
  (foreach n rgb
    (setq out (strcat out (substr digits (1+ (/ n 16)) 1)
      (substr digits (1+ (rem n 16)) 1)))) out)
(defun xyzt:percent (part total)
  (if (> total 0) (* 100.0 (/ (float part) total)) 0.0))
(defun xyzt:tc (rgb) (+ (* (car rgb) 65536) (* (cadr rgb) 256) (caddr rgb)))

;;; Numeros estrictos: signo, decimal elegido y exponente E/D. Sin separadores
;;; de millares ni unidades. Cero es valido. No depende de LUNITS.
(defun xyzt:number (s decimal / i n ch digits dot expo expdigits expstart ok norm)
  (setq s (xyzt:trim s) i 1 n (strlen s) digits 0 dot nil expo nil
        expdigits 0 expstart nil ok T norm "")
  (if (and (> n 0) (member (substr s 1 1) '("+" "-")))
    (setq norm (substr s 1 1) i 2))
  (while (and ok (<= i n))
    (setq ch (strcase (substr s i 1)))
    (cond
      ((and (>= (ascii ch) 48) (<= (ascii ch) 57))
        (if expo (setq expdigits (1+ expdigits)) (setq digits (1+ digits)))
        (setq norm (strcat norm ch) expstart nil))
      ((and (= ch decimal) (not dot) (not expo))
        (setq dot T norm (strcat norm ".")))
      ((and (member ch '("E" "D")) (not expo) (> digits 0))
        (setq expo T expstart T norm (strcat norm "E")))
      ((and expstart (member ch '("+" "-")))
        (setq norm (strcat norm ch) expstart nil))
      (T (setq ok nil)))
    (setq i (1+ i)))
  (if (and ok (> digits 0) (or (not expo) (> expdigits 0)))
    (distof norm (if expo 1 2)) nil))

(defun xyzt:setting-number (s / value)
  ;; OR en AutoLISP devuelve T/nil, nunca el numero encontrado.
  (setq value (xyzt:number s "."))
  (if (null value) (setq value (xyzt:number s ",")))
  value)

;;; Campos CSV con comillas dobles escapadas. WS colapsa espacios y tabs.
;;; Retorna nil si hay comillas sin cerrar o caracteres tras una comilla final.
(defun xyzt:fields (s sep / i n ch out field quoted afterq started valid delim)
  (setq i 1 n (strlen s) out nil field "" quoted nil afterq nil started nil valid T)
  (while (and valid (<= i n))
    (setq ch (substr s i 1)
          delim (if (= sep "WS") (member ch (list " " (chr 9))) (= ch sep)))
    (cond
      (quoted
        (if (= ch "\"")
          (if (and (< i n) (= (substr s (1+ i) 1) "\""))
            (setq field (strcat field "\"") i (1+ i))
            (setq quoted nil afterq T))
          (setq field (strcat field ch))))
      (delim
        (if (or (/= sep "WS") started afterq)
          (setq out (cons (xyzt:trim field) out)))
        (setq field "" afterq nil started nil))
      (afterq (if (/= ch " ") (setq valid nil)))
      ((= ch "\"")
        (if (= (xyzt:trim field) "") (setq field "" quoted T started T)
          (setq valid nil)))
      (T (setq field (strcat field ch) started T)))
    (setq i (1+ i)))
  (if (or quoted (not valid)) nil
    (progn
      (if (or (/= sep "WS") started afterq) (setq out (cons (xyzt:trim field) out)))
      (reverse out))))
(defun xyzt:separator (cfg)
  (nth (atoi (xyzt:get "sep" cfg)) (list "AUTO" "WS" (chr 9) ";" ",")))
(defun xyzt:decimal (cfg) (if (= (xyzt:get "decimal" cfg) "1") "," "."))
(defun xyzt:line (s cfg sep / fields x y z maxcol dec)
  (setq fields (xyzt:fields s sep) dec (xyzt:decimal cfg)
        maxcol (max (atoi (xyzt:get "cx" cfg)) (atoi (xyzt:get "cy" cfg))
                    (atoi (xyzt:get "cz" cfg))))
  (if (and fields (>= (length fields) maxcol)
           (setq x (xyzt:number (nth (1- (atoi (xyzt:get "cx" cfg))) fields) dec))
           (setq y (xyzt:number (nth (1- (atoi (xyzt:get "cy" cfg))) fields) dec))
           (setq z (xyzt:number (nth (1- (atoi (xyzt:get "cz" cfg))) fields) dec)))
    (progn
      (setq x (* x (xyzt:get 'xyfactor cfg)) y (* y (xyzt:get 'xyfactor cfg))
            z (+ (* z (xyzt:get 'zfactor cfg)) (xyzt:get 'offset cfg)))
      (if (and (<= (abs x) 1e9) (<= (abs y) 1e9) (<= (abs z) 1e7))
        (list x y z) nil)) nil))
(defun xyzt:comment (s / v)
  (setq v (xyzt:trim s))
  (or (= v "") (member (substr v 1 1) '("#" ";"))
      (= (substr v 1 2) "//")))
(defun xyzt:header (s cfg sep / fields vals)
  (setq fields (xyzt:fields s sep))
  (if fields
    (progn
      (setq vals (mapcar '(lambda (key / v)
        (setq v (nth (1- (atoi (xyzt:get key cfg))) fields))
        (if v (strcase (xyzt:trim v)) "")) '("cx" "cy" "cz")))
      (and (member (car vals) '("X" "E" "ESTE" "EASTING" "Y" "N" "NORTE" "NORTHING"))
           (member (cadr vals) '("X" "E" "ESTE" "EASTING" "Y" "N" "NORTE" "NORTHING"))
           (member (caddr vals) '("Z" "COTA" "ELEVACION" "ELEVATION" "DEPTH" "PROFUNDIDAD"))))))
(defun xyzt:read-line (f / s)
  (setq s (read-line f))
  (if (and s (> (strlen s) 0) (= (ascii (substr s 1 1)) 65279)) (setq s (substr s 2)))
  (if (and s (>= (strlen s) 3) (= (ascii (substr s 1 1)) 239)
           (= (ascii (substr s 2 1)) 187) (= (ascii (substr s 3 1)) 191))
    (setq s (substr s 4))) s)
(defun xyzt:open-input (path / f)
  (if (not (setq f (open path "r"))) (xyzt:fail "No se pudo abrir el archivo de entrada."))
  (setq *xyzt:in* f) f)
(defun xyzt:close-input ()
  (if *xyzt:in* (progn (close *xyzt:in*) (setq *xyzt:in* nil))))
(defun xyzt:detect (cfg / f s ln seen candidates scores sep score p best bestscore ties pair)
  (setq sep (xyzt:separator cfg))
  (if (/= sep "AUTO") sep
    (progn
      (setq candidates (if (= (xyzt:decimal cfg) ",") (list "WS" (chr 9) ";")
                         (list "WS" (chr 9) ";" ","))
            scores (mapcar '(lambda (v) (cons v 0)) candidates)
            f (xyzt:open-input (xyzt:get "file" cfg)) ln 0 seen 0)
      (while (and (< seen 100) (setq s (xyzt:read-line f)))
        (setq ln (1+ ln))
        (if (and (> ln (atoi (xyzt:get "skip" cfg))) (not (xyzt:comment s)))
          (progn
            (setq seen (1+ seen))
            (foreach sep candidates
              (if (xyzt:line s cfg sep)
                (setq scores (xyzt:put sep (1+ (xyzt:get sep scores)) scores)))))))
      (xyzt:close-input)
      (setq best nil bestscore 0 ties nil)
      (foreach pair scores
        (cond ((> (cdr pair) bestscore) (setq best (car pair) bestscore (cdr pair) ties nil))
              ((and (> (cdr pair) 0) (= (cdr pair) bestscore))
                ;; TAB y WS equivalen en archivos tabulados: preferir WS.
                (if (not (and (= best "WS") (= (car pair) (chr 9)))) (setq ties T)))))
      (if (or (not best) ties)
        (xyzt:fail "Separador automatico ambiguo o sin puntos. Elija el separador y revise columnas/decimales."))
      best)))

