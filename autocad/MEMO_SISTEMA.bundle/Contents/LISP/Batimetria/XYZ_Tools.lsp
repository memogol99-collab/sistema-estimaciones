  (xyzt:fill-popup "units" '("Entrada en metros" "Entrada en pies internacionales" "Entrada en milimetros"))
  (xyzt:fill-popup "zmode" '("Conservar signo Z" "Profundidad positiva -> elevacion (-Z)"))
  (xyzt:fill-popup "palette" '("CCN topografica" "CCN batimetrica"))
  (xyzt:fill-popup "classmode" '("Automatico redondeado (clases aprox.)" "Intervalo fijo @ (m)" "Limites comunes redondeados"))
  (xyzt:fill-popup "outside" '("Excluir fuera de limites comunes" "Incluir en clases << y >>"))
  (xyzt:fill-popup "reduce" '("Sin reduccion" "Uno de cada N" "Celda: primer punto" "Celda: mas somero (Z mayor)" "Celda: mas profundo (Z menor)" "Distancia minima XY"))
  (xyzt:fill-popup "duplicates" '("Conservar duplicados" "Eliminar XYZ exactamente iguales" "Eliminar cercanos por distancia 3D"))
