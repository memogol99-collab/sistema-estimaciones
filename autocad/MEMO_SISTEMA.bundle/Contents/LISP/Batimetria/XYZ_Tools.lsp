(defun xyzt:preview (cfg sep / f s ln shown p text)
  (setq f (xyzt:open-input (xyzt:get "file" cfg)) ln 0 shown 0 text "Vista previa (coordenadas de salida en metros):\n")
  (while (and (< shown 8) (setq s (xyzt:read-line f)))
    (setq ln (1+ ln))
    (if (> ln (atoi (xyzt:get "skip" cfg)))
      (progn
        (setq shown (1+ shown) p (xyzt:line s cfg sep))
        (setq text (strcat text "\nL" (itoa ln) " " (substr s 1 90) "\n -> "
          (if p (strcat (xyzt:nstr (car p)) " | " (xyzt:nstr (cadr p)) " | " (xyzt:nstr (caddr p))) "No es una fila XYZ valida"))))))
  (xyzt:close-input) (alert text))
(defun xyzt:select-lot (/ sel lot)
  (setq sel (entsel "\nSeleccione un punto o leyenda creado por XYZ-Tools 7: "))
  (if sel
    (if (setq lot (xyzt:lot-of (car sel))) lot
      (xyzt:fail "El objeto no pertenece a un lote XYZ-Tools 7. Los objetos antiguos se conservan."))))
(defun c:XYZAYUDA ()
  (alert (strcat "XYZ-Tools " *xyzt:version* " - Guia rapida\n\n"
    "XYZ / IXYZ: importar. Botones Procesar/Unir abren esos modos.\n"
    "P-Z: panel Pantalla/Archivo. IZ: invierte puntos POINT seleccionados.\n"
    "OZ: mueve seleccion en Z mundial; ZM: estadisticas de puntos.\n"
    "EXYZ / XYZEXPORTAR: exportar seleccion POINT. No modifica el dibujo.\n"
    "Colores: intervalos redondeados; modo fijo admite @0.50, @1.00, etc.\n"
    "La simbologia se ubica despues de importar y mostrar la nube.\n"
    "XYZU: alias de union. Procesar incluye Z minima/maxima de archivo.\n"
    "N/ID X Y Z: elegir formato o columnas 2,3,4. No se adivinan columnas.\n"
    "IZ/OZ cambian solo objetos seleccionados. Revisar etiquetas y leyendas.\n"
    "PZ: procesar directo. XYZUNIR: unir directo. Etiquetas: boton dedicado.\n"
    "Procesar: invierte Z, offset, rangos o elimina un rango.\n"
    "Conserva X/Y y campos adicionales; normaliza separadores/comillas.\n"
    "Rangos ordenados [min,max); ultimo incluye max. No superposiciones.\n"
    "Unir: salida XYZ normalizada; mismas unidades y sistema en las fuentes.\n"
    "Decimales -1 conserva hasta 16 decimales, sin ceros de relleno.\n"
    "Nunca sobrescribe originales; agrega consecutivo si existe el destino.\n"
    "1. Archivo, separador, decimal y columnas (desde 1).\n"
    "2. Unidades de entrada. Salida siempre en METROS y WCS.\n"
    "3. Z: conservar o negar; despues sumar Delta Z en METROS.\n"
    "   Ejemplo profundidad d y agua H: Z=H-d (Delta Z=H).\n"
    "   Datos HYPACK ya reducidos: conservar Z; Delta Z=0.\n"
    "4. Declarar sistema y referencia vertical. NO reproyecta.\n"
    "5. Filtros y clases usan coordenadas YA convertidas.\n"
    "6. Vista previa y Analizar. Importar vuelve a analizar siempre.\n\n"
    "CELDAS: ancladas al origen WCS; cada celda conserva un punto real.\n"
    "Mas somero=Z mayor; profundo=Z menor (elevaciones finales).\n"
    "Distancia minima y Cada N dependen del orden de entrada.\n"
    "Duplicados: XYZ exacto o distancia 3D menor que tolerancia.\n"
    "Se filtra antes de reducir; limites de clases comunes se aplican primero.\n"
    "CSV: separador ; y punto decimal. Importar en Excel indicando ambos.\n"
    "Resultados y descartes llevan ID de lote, nunca sobrescriben otros.\n\n"
    "XYZLOTES: ver lotes. XYZBORRAR: borrar solo lote seleccionado.\n"
    "XYZRESTAURAR: visibilidad anterior (durante esta sesion/documento).\n"
    "XYZTEST: comprobaciones de funciones puras. U: deshacer importacion.\n"
    "El respaldo opcional es del XYZ, no del DWG.\n"
    "Trabajar en un dibujo en METROS, desde Modelo. No cambia INSUNITS.\n"
    "Leyenda en plano XY mundial a Z=0.\n"
    "Celdas y tolerancias: minimo 0.000001 m; clases: maximo 100.\n"
    "Numeros de ajustes aceptan punto o coma. Archivo segun decimal elegido.\n"
    "Coordenadas admitidas: |X,Y|<=1e9; |Z|<=1e7 metros.\n"
    "No elimina atipicos automaticamente ni procesa sonar crudo.\n"
    "Integracion AutoCAD/ZWCAD: pendiente de validacion en el equipo.")) (princ))
(defun c:XYZLOTES (/ root pair data key count)
  (setq root (dictsearch (namedobjdict) "IXYZ7_LOTES") count 0)
  (if root
    (progn
      (setq root (cdr (assoc -1 root)))
      (foreach pair (entget root)
        (if (= (car pair) 3)
          (progn
            (setq key (cdr pair) data (dictsearch root key) count (1+ count))
            (princ (strcat "\n" key))
            (foreach pair data
              (if (and (= (car pair) 1)
                 (or (wcmatch (cdr pair) "FUENTE=*") (wcmatch (cdr pair) "IMPORTADOS=*")))
                (princ (strcat " | " (cdr pair))))))))))
  (princ (strcat "\nLotes registrados: " (itoa count))) (princ))
(defun c:XYZBORRAR (/ *error* lot en doc mark deleted root record)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) deleted nil mark nil *xyzt:failure* nil)
  (defun *error* (msg)
    (setq msg (if *xyzt:failure* *xyzt:failure* msg) *xyzt:failure* nil)
    (foreach en deleted (vl-catch-all-apply 'entdel (list en)))
    (if mark (vl-catch-all-apply 'vla-EndUndoMark (list doc)))
    (princ (strcat "\nXYZBORRAR: " msg)) (princ))
  (if (setq lot (xyzt:select-lot))
    (progn
      (vla-StartUndoMark doc) (setq mark T)
      (foreach en (xyzt:lot-selection lot)
        (if (entdel en) (setq deleted (cons en deleted)) (xyzt:fail "No se pudo borrar el lote completo.")))
      ;; Se mantiene XRECORD como historial del lote borrado.
      (vla-EndUndoMark doc) (setq mark nil deleted nil)
      (princ (strcat "\nLote " lot " borrado. Historial conservado; U permite deshacer.")))) (princ))

(defun xyzt:run (/ code validated res path cfg sep stats classes lot doc mark oldcm olddz
                   oldpd legendbase legendname reportpath logpath backupdir backuppath
                   outputdir start seconds en pair filesok done source-stamp newstamp tmp entry process-result)
  (setq oldcm (getvar "CMDECHO") olddz (getvar "DIMZIN") oldpd (getvar "PDSIZE")
        doc (vla-get-ActiveDocument (vlax-get-acad-object)) mark nil lot nil done nil
        *xyzt:in* nil *xyzt:out* nil *xyzt:log* nil *xyzt:objects* nil *xyzt:newlayers* nil *xyzt:deleted* nil
        *xyzt:polygon* nil *xyzt:replace* nil *xyzt:status* "Vista previa -> Analizar -> Importar")

  (if (not *xyzt:lastcfg*) (setq *xyzt:lastcfg* (xyzt:defaults)))
  (setq *xyzt:ui* *xyzt:lastcfg*)
  (setvar "DIMZIN" 0)
  (xyzt:make-dcl)
  (setq *xyzt:dclid* (load_dialog *xyzt:dclfile*))
  (if (< *xyzt:dclid* 0) (xyzt:fail "No se pudo cargar DCL temporal."))
  (setq entry *xyz:entry* *xyz:entry* nil code -1)
  (if entry
    (progn
      (setq process-result (cond ((= entry "export") (xyz:export-screen) nil) ((= entry "pointtools") (xyz:pointtools-flow)) (T (xyz:process-flow (= entry "merge")))))
      (if process-result
        (setq cfg (xyzt:validate *xyzt:ui*) sep (xyzt:detect cfg) stats (xyzt:analyze cfg nil sep)
              source-stamp (xyz:signature (xyzt:get "file" cfg)) code 1)
        (setq code 0))))
  (while (and (/= code 0) (/= code 1))
    (setq code (xyzt:dialog))
    (cond
      ((= code 2)
        (setq path (getfiled "Archivo XYZ / TXT / CSV" (xyzt:get "file" *xyzt:ui*) "xyz;txt;csv;asc" 0))
        (if path (setq *xyzt:ui* (xyzt:put "file" path *xyzt:ui*) *xyzt:status* "Archivo cambiado: vuelva a analizar.")))
      ((= code 3)
        (setq res (xyzt:try 'xyzt:polygon nil))
        (if (vl-catch-all-error-p res) (alert (xyzt:errmsg res)) (setq *xyzt:polygon* res)))
      ((member code '(1 4 5))
        (setq res (xyzt:try 'xyzt:validate (list *xyzt:ui*)))
        (if (vl-catch-all-error-p res) (progn (alert (xyzt:errmsg res)) (setq code -1))
          (progn
            (setq cfg res source-stamp (list (vl-file-size (xyzt:get "file" cfg)) (vl-file-systime (xyzt:get "file" cfg)))
                  res (xyzt:try 'xyzt:detect (list cfg)))
            (if (vl-catch-all-error-p res)
              (progn (xyzt:close-input) (alert (xyzt:errmsg res)) (setq code -1))
              (progn
                (setq sep res)
                (if (= code 5)
                  (setq res (xyzt:try 'xyzt:preview (list cfg sep)))
                  (progn
                    (setq res (xyzt:try 'xyzt:analyze (list cfg *xyzt:polygon* sep)))
                    (if (not (vl-catch-all-error-p res))
                      (progn
                        (setq stats res *xyzt:status* (strcat "Ultimo analisis: " (itoa (xyzt:get 'lines stats)) " filas. Importar recalcula con los ajustes actuales."))
                        (if (= code 4) (alert (xyzt:stats-text stats)))))))
                (if (vl-catch-all-error-p res)
                  (progn (xyzt:close-input) (alert (xyzt:errmsg res)) (setq code -1))
                (if (and (= code 1) (= 0 (car (car (xyzt:get 'eligible stats)))))
                  (progn (alert "No hay puntos dentro de los filtros.") (setq code -1)))))))))
      ((= code 6)
        (setq res (xyzt:try 'xyzt:select-lot nil))
        (if (vl-catch-all-error-p res) (alert (xyzt:errmsg res)) (setq *xyzt:replace* res)))
      ((member code '(9 10))
        (setq process-result (xyz:process-flow (= code 10)))
        (if process-result
          (setq cfg (xyzt:validate *xyzt:ui*) sep (xyzt:detect cfg) stats (xyzt:analyze cfg *xyzt:polygon* sep)
                source-stamp (xyz:signature (xyzt:get "file" cfg)) code 1)))
      ((= code 13) (xyz:export-screen))
      ((= code 12)
        (setq process-result (xyz:pointtools-flow))
        (if process-result
          (setq cfg (xyzt:validate *xyzt:ui*) sep (xyzt:detect cfg) stats (xyzt:analyze cfg *xyzt:polygon* sep)
                source-stamp (xyz:signature (xyzt:get "file" cfg)) code 1)))
      ((= code 11) (xyz:labels-dialog))
      ((= code 7) (c:XYZAYUDA))
      ((= code 8)
        (setq path (getfiled "Elija carpeta de salida (nombre solo orientativo)" "IXYZ.csv" "csv" 1))
        (if path (setq *xyzt:ui* (xyzt:put "outdir" (vl-filename-directory path) *xyzt:ui*))))))
  (setq *xyzt:lastcfg* *xyzt:ui*)
  (if (= code 1)
    (progn
      (if (not (= (getvar "TILEMODE") 1)) (xyzt:fail "Para importar puntos, active la pestana Modelo."))
      (if (= 0 (logand 1 (getvar "UNDOCTL"))) (xyzt:fail "Active DESHACER antes de importar."))
      (if (= 0 (car (car (xyzt:get 'eligible stats)))) (xyzt:fail "Ningun punto dentro de filtros de importacion."))
      (setq *xyzt:active-lot* nil lot (xyzt:lot-id) *xyzt:active-lot* lot
            classes (xyzt:classes cfg stats lot))
      ;; Si el archivo cambia entre analisis y lectura se aborta sin reemplazar lote.
      (if (not (equal source-stamp (list (vl-file-size (xyzt:get "file" cfg)) (vl-file-systime (xyzt:get "file" cfg)))))
        (xyzt:fail "El archivo cambio durante el analisis. Repita con archivo estable."))
      ;; Validar servicios espaciales antes de crear objetos.
      (if (or (>= (atoi (xyzt:get "reduce" cfg)) 2) (/= (xyzt:get "duplicates" cfg) "0"))
        (progn (xyzt:new-dict) (xyzt:release)))
      (setq outputdir (if (= (xyzt:get "outdir" cfg) "") (vl-filename-directory (xyzt:get "file" cfg)) (xyzt:get "outdir" cfg))
            reportpath (strcat outputdir "\\" (vl-filename-base (xyzt:get "file" cfg)) "_" lot "_resultados.csv")
            logpath (strcat outputdir "\\" (vl-filename-base (xyzt:get "file" cfg)) "_" lot "_descartes.csv"))
      (if (= (xyzt:get "csv" cfg) "1")
        (progn
          (if (or (findfile logpath) (findfile reportpath)) (xyzt:fail "Ya existe un reporte con ese ID; no se sobrescribio."))
          (setq *xyzt:report-files* (list logpath reportpath))
          (setq *xyzt:log* (open logpath "w"))
          (if (not *xyzt:log*) (xyzt:fail "No se puede escribir CSV. Elija otra carpeta o desactive CSV."))
          (write-line "Linea;Motivo;Contenido" *xyzt:log*)))
      (if (= (xyzt:get "backup" cfg) "1")
        (progn
          (setq backuppath (strcat outputdir "\\" (vl-filename-base (xyzt:get "file" cfg)) "_" lot "_FUENTE"
                             (vl-filename-extension (xyzt:get "file" cfg))))
          (if (not (vl-file-copy (xyzt:get "file" cfg) backuppath)) (xyzt:fail "Fallo el respaldo del archivo fuente."))
          (princ (strcat "\nRespaldo fuente: " backuppath))))
      (setq legendbase nil)
      (setvar "CMDECHO" 0) (setvar "DIMZIN" 0)
      (vla-StartUndoMark doc) (setq *xyzt:undo* T)
      (regapp "IXYZ7")
      (foreach pair classes (xyzt:layer (car pair) (nth 3 pair)))
      (setq *xyz:label-layer* nil)
      (if (and (= (xyzt:get "labels" cfg) "1") (= (xyzt:get "labelone" cfg) "1"))
        (progn
          (setq *xyz:label-layer* (strcat (xyzt:get "labellayer" cfg) "_" lot))
          (xyzt:layer *xyz:label-layer* '(255 255 255))))
      (setq start (getvar "MILLISECS"))
      (xyzt:import cfg *xyzt:polygon* sep classes lot)
      (setq seconds (/ (- (getvar "MILLISECS") start) 1000.0))
      (if (< seconds 0.0) (setq seconds 0.0))
      (if *xyzt:log* (progn (close *xyzt:log*) (setq *xyzt:log* nil)))
      (setq newstamp (list (vl-file-size (xyzt:get "file" cfg)) (vl-file-systime (xyzt:get "file" cfg))))
      (if (not (equal source-stamp newstamp)) (xyzt:fail "El archivo cambio durante la importacion. Repita con archivo estable."))
      (if (= *xyzt:imported* 0) (xyzt:fail "Ningun punto creado. El lote anterior se conserva."))
      ;; Mostrar la nube ANTES de pedir la ubicacion de la simbologia.
      (if (= (xyzt:get "legend" cfg) "1")
        (progn
          (vl-catch-all-apply 'vla-ZoomWindow
            (list (vlax-get-acad-object)
              (vlax-3d-point (mapcar '- (nth 3 *xyzt:importstats*) '(1.0 1.0 0.0)))
              (vlax-3d-point (mapcar '+ (nth 4 *xyzt:importstats*) '(1.0 1.0 0.0)))))
          (vla-Regen doc 1) (redraw)
          (princ "\nNube importada y mostrada. Ubique ahora la simbologia.")
          (setq res (xyzt:try 'getpoint (list "\nInsercion de simbologia (Enter/Esc: omitir y conservar puntos): ")))
          (if (not (vl-catch-all-error-p res))
            (if res (setq legendbase (trans res 1 0)))
            (progn (setq *xyzt:failure* nil) (princ "\nSimbologia omitida; los puntos se conservan.")))))
      (setq legendname (if legendbase (xyzt:legend classes cfg lot legendbase) nil))
      (xyzt:record lot cfg classes stats *xyzt:imported* *xyzt:counts*)
      (if (= (xyzt:get "csv" cfg) "1") (xyzt:report reportpath cfg sep lot classes stats seconds))
      (if *xyzt:replace*
        (foreach en (xyzt:lot-selection *xyzt:replace*)
          (if (entdel en) (setq *xyzt:deleted* (cons en *xyzt:deleted*))
            (xyzt:fail "No se pudo reemplazar el lote completo. Se restaura el anterior."))))
      (if (/= (xyzt:get 'v-pdsize cfg) 0.0) (setvar "PDSIZE" (xyzt:get 'v-pdsize cfg)))
      (vla-EndUndoMark doc) (setq *xyzt:undo* nil *xyzt:active-lot* nil *xyzt:deleted* nil *xyzt:newlayers* nil)
      (setq *xyzt:report-files* nil done T)
      ;; Operaciones visuales auxiliares no invalidan una importacion terminada.
      (if (and (= (xyzt:get "zoom" cfg) "1") (/= (xyzt:get "legend" cfg) "1"))
        (vl-catch-all-apply 'vla-ZoomWindow
          (list (vlax-get-acad-object)
            (vlax-3d-point (mapcar '- (nth 3 *xyzt:importstats*) '(1.0 1.0 0.0)))
            (vlax-3d-point (mapcar '+ (nth 4 *xyzt:importstats*) '(1.0 1.0 0.0))))))
      (if (= (xyzt:get "isolate" cfg) "1")
        (progn
          (setq res (vl-catch-all-apply 'xyzt:isolate (list (append (mapcar 'car classes) (if legendname (list legendname) nil) (if *xyz:label-layer* (list *xyz:label-layer*) nil)))))
          (if (vl-catch-all-error-p res) (princ "\nNo se completo aislamiento; los puntos se importaron."))))
      (vl-catch-all-apply 'vla-Regen (list doc 1))
      (princ (strcat "\nXYZ-Tools " *xyzt:version* " | Lote " lot " | " (itoa *xyzt:imported*) " puntos | " (rtos seconds 2 2) " s"))
      (foreach pair *xyzt:counts* (princ (strcat "\n  " (car pair) ": " (itoa (cdr pair)))))
      (if (= (xyzt:get "csv" cfg) "1") (princ (strcat "\nResultados: " reportpath "\nDescartes: " logpath)))
      (alert (strcat "Importacion terminada\nLote: " lot "\nPuntos: " (itoa *xyzt:imported*)
        "\nTiempo del motor: " (rtos seconds 2 2) " s\n\nU deshace los cambios del dibujo."
        (if (= (xyzt:get "csv" cfg) "1") (strcat "\nCSV: " reportpath) "")))))
  (xyzt:cleanup)
  (setvar "CMDECHO" oldcm) (setvar "DIMZIN" olddz)
  (princ))
(defun c:XYZ (/ *error* savedcm saveddz savedpd doc path)
  (setq savedcm (getvar "CMDECHO") saveddz (getvar "DIMZIN") savedpd (getvar "PDSIZE")
        doc (vla-get-ActiveDocument (vlax-get-acad-object))
        *xyzt:active-lot* nil *xyzt:undo* nil *xyzt:report-files* nil *xyzt:failure* nil *xyz:workfiles* nil
        *xyzt:in* nil *xyzt:out* nil *xyzt:log* nil *xyzt:dclid* nil *xyzt:dclfile* nil
        *xyzt:objects* nil *xyzt:newlayers* nil *xyzt:deleted* nil)
  (defun *error* (msg)
    (setq msg (if *xyzt:failure* *xyzt:failure* msg) *xyzt:failure* nil)
    (xyzt:cleanup)
    (if *xyzt:active-lot* (xyzt:rollback *xyzt:active-lot*))
    (if *xyzt:undo* (vl-catch-all-apply 'vla-EndUndoMark (list doc)))
    (foreach path *xyzt:report-files* (if (findfile path) (vl-file-delete path)))
    (setvar "CMDECHO" savedcm) (setvar "DIMZIN" saveddz) (setvar "PDSIZE" savedpd)
    (setq *xyzt:undo* nil *xyzt:active-lot* nil *xyzt:report-files* nil)
    (princ (strcat "\nXYZ-Tools detenido: " (if msg msg "sin mensaje") "\nSe retiraron los objetos del lote incompleto, si los habia."))
    (princ))
  (xyzt:run) (princ))

(defun xyzt:rgb-ccn (indice total batimetria / escala ratio pos-frac pos-entera c1 c2 r g b)
  (setq escala '(
      (36 18 0) (100 50 0) (150 0 0) (255 0 0) (255 71 26)
      (255 100 0) (255 150 0) (255 255 0) (10 208 6) (6 147 44)
      (10 214 156) (0 200 255) (0 100 255) (0 0 255) (26 21 157)
      (16 13 99) (11 9 68)))
  (if batimetria (setq escala (reverse escala)))
  (if (<= total 1)
    (setq ratio 0.0)
    (setq ratio (/ (float (1- indice)) (float (1- total))))
  )
  (setq pos-frac (* ratio (1- (length escala))))
  (setq pos-entera (fix pos-frac))
  (if (>= pos-entera (1- (length escala)))
    (setq pos-entera (1- (length escala)))
  )
  (if (= pos-entera (1- (length escala)))
    (nth pos-entera escala)
    (progn
      (setq c1 (nth pos-entera escala)
            c2 (nth (1+ pos-entera) escala)
            pos-frac (- pos-frac pos-entera))
      (setq r (fix (+ (car c1) (* pos-frac (- (car c2) (car c1))))))
      (setq g (fix (+ (cadr c1) (* pos-frac (- (cadr c2) (cadr c1))))))
      (setq b (fix (+ (caddr c1) (* pos-frac (- (caddr c2) (caddr c1))))))
      (list (max 0 (min 255 r)) (max 0 (min 255 g)) (max 0 (min 255 b)))
    )
  )
)

