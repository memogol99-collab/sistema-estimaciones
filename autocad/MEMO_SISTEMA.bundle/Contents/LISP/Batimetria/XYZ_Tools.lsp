(setq xyzt:keys '("file" "sep" "decimal" "cx" "cy" "cz" "skip" "units" "zmode" "dz" "ref" "crs" "prefix" "palette" "classmode" "classes" "step" "base" "top" "outside" "reduce" "every" "spacing" "duplicates" "tol" "xyfilter" "xmin" "xmax" "ymin" "ymax" "zfilter" "zmin" "zmax" "legend" "height" "csv" "zoom" "isolate" "backup" "outdir" "pdsize"))
(defun xyzt:validate (cfg / key val cols factor num step base top count prefix)
  (if (or (= (xyzt:get "file" cfg) "") (not (findfile (xyzt:get "file" cfg))))
    (xyzt:fail "Seleccione un archivo existente."))
  (foreach key '("cx" "cy" "cz" "skip" "classes" "every")
    (setq val (xyzt:number (xyzt:get key cfg) "."))
    (if (or (null val) (/= val (fix val))
            (< val (if (= key "skip") 0 1)) (> val 1000000000))
      (xyzt:fail (strcat "Entero invalido: " key))))
  (setq cols (mapcar '(lambda (k) (atoi (xyzt:get k cfg))) '("cx" "cy" "cz")))
  (if (or (= (car cols) (cadr cols)) (= (car cols) (caddr cols)) (= (cadr cols) (caddr cols)))
    (xyzt:fail "X, Y y Z deben usar columnas distintas."))
  (if (> (apply 'max cols) 1000) (xyzt:fail "Maximo 1000 columnas."))
  (foreach key '("dz" "step" "base" "top" "spacing" "tol" "xmin" "xmax" "ymin" "ymax" "zmin" "zmax" "height" "pdsize")
    (setq val (xyzt:setting-number (xyzt:get key cfg)))
    (if (or (null val) (> (abs val) 1e12)) (xyzt:fail (strcat "Numero invalido: " key)))
    (setq cfg (xyzt:put (read (strcat "v-" key)) val cfg)))
  (foreach key '("step" "spacing" "tol" "height")
    (if (<= (xyzt:get (read (strcat "v-" key)) cfg) 0) (xyzt:fail (strcat key " debe ser mayor que cero."))))
  (if (or (< (xyzt:get 'v-spacing cfg) 0.000001) (< (xyzt:get 'v-tol cfg) 0.000001))
    (xyzt:fail "Celda/distancia y tolerancia: minimo 0.000001 m."))
  (if (> (atoi (xyzt:get "classes" cfg)) 100) (xyzt:fail "Maximo 100 clases."))
  (if (and (= (xyzt:get "sep" cfg) "4") (= (xyzt:decimal cfg) ","))
    (xyzt:fail "Coma decimal y coma separadora son ambiguas. Use punto y coma o TAB."))
  (if (and (= (xyzt:get "xyfilter" cfg) "1")
      (or (> (xyzt:get 'v-xmin cfg) (xyzt:get 'v-xmax cfg)) (> (xyzt:get 'v-ymin cfg) (xyzt:get 'v-ymax cfg))))
    (xyzt:fail "Limites XY invertidos."))
  (if (and (= (xyzt:get "zfilter" cfg) "1") (> (xyzt:get 'v-zmin cfg) (xyzt:get 'v-zmax cfg)))
    (xyzt:fail "Limites Z invertidos."))
  (if (and (= (xyzt:get "classmode" cfg) "2") (>= (xyzt:get 'v-base cfg) (xyzt:get 'v-top cfg)))
    (xyzt:fail "El limite superior comun debe superar al inferior."))
  (setq prefix (xyzt:trim (xyzt:get "prefix" cfg)))
  (if (or (= prefix "") (> (strlen prefix) 40) (not (snvalid prefix)))
    (xyzt:fail "Prefijo de capa invalido (maximo 40 caracteres)."))
  (if (or (> (strlen (xyzt:get "ref" cfg)) 120) (> (strlen (xyzt:get "crs" cfg)) 120))
    (xyzt:fail "Referencia y sistema: maximo 120 caracteres."))
  (setq factor (nth (atoi (xyzt:get "units" cfg)) '(1.0 0.3048 0.001)))
  (setq cfg (xyzt:put 'xyfactor factor cfg)
        cfg (xyzt:put 'zfactor (* factor (if (= (xyzt:get "zmode" cfg) "0") 1.0 -1.0)) cfg)
        cfg (xyzt:put 'offset (xyzt:get 'v-dz cfg) cfg))
  (if (and (/= (xyzt:get "outdir" cfg) "") (not (vl-file-directory-p (xyzt:get "outdir" cfg))))
    (xyzt:fail "La carpeta de salida no existe."))
  (xyz:validate-labels cfg))

;;; Poligono: LWPOLYLINE cerrada, recta, horizontal. Vertices convertidos a WCS.
(defun xyzt:polygon (/ sel en ed verts bulge normal item q)
  (setq sel (entsel "\nSeleccione polilinea cerrada sin arcos para filtro XY: "))
  (if sel
    (progn
      (setq en (car sel) ed (entget en) verts nil bulge nil normal (cdr (assoc 210 ed)))
      (if (or (/= (cdr (assoc 0 ed)) "LWPOLYLINE")
              (= 0 (logand 1 (cdr (assoc 70 ed))))
              (and normal (not (equal normal '(0.0 0.0 1.0) 1e-9))))
        (xyzt:fail "Use una LWPOLYLINE cerrada horizontal con normal +Z."))
      (foreach item ed
        (if (and (= (car item) 42) (/= (cdr item) 0.0)) (setq bulge T))
        (if (= (car item) 10)
          (progn (setq q (trans (list (cadr item) (caddr item) (cond ((cdr (assoc 38 ed))) (T 0.0))) en 0))
                 (setq verts (cons (list (car q) (cadr q)) verts)))))
      (if (or bulge (< (length verts) 3)) (xyzt:fail "El filtro requiere al menos 3 vertices y ningun arco."))
      (reverse verts))))
(defun xyzt:on-segment (p a b / dx dy len2 u q)
  (setq dx (- (car b) (car a)) dy (- (cadr b) (cadr a)) len2 (+ (* dx dx) (* dy dy)))
  (if (= len2 0.0) (equal (list (car p) (cadr p)) a 1e-8)
    (progn
      (setq u (/ (+ (* (- (car p) (car a)) dx) (* (- (cadr p) (cadr a)) dy)) len2))
      (and (>= u -1e-10) (<= u 1.0000000001)
           (<= (abs (- (* (- (car p) (car a)) dy) (* (- (cadr p) (cadr a)) dx)))
               (* 1e-8 (sqrt len2)))))))
(defun xyzt:inside (p poly / a b hit boundary)
  (setq a (last poly) hit nil boundary nil)
  (foreach b poly
    (if (xyzt:on-segment p a b) (setq boundary T))
    (if (and (not (eq (> (cadr a) (cadr p)) (> (cadr b) (cadr p))))
             (< (car p) (+ (car a) (* (- (car b) (car a))
                  (/ (- (cadr p) (cadr a)) (- (cadr b) (cadr a)))))))
      (setq hit (not hit)))
    (setq a b))
  (or boundary hit))
(defun xyzt:filter-reason (p cfg poly)
  (cond
    ((or (> (abs (car p)) 1e10) (> (abs (cadr p)) 1e10) (> (abs (caddr p)) 1e8)) "RANGO_NUMERICO")
    ((and (= (xyzt:get "xyfilter" cfg) "1")
      (or (< (car p) (xyzt:get 'v-xmin cfg)) (> (car p) (xyzt:get 'v-xmax cfg))
          (< (cadr p) (xyzt:get 'v-ymin cfg)) (> (cadr p) (xyzt:get 'v-ymax cfg)))) "FUERA_XY")
    ((and poly (not (xyzt:inside p poly))) "FUERA_POLIGONO")
    ((and (= (xyzt:get "zfilter" cfg) "1")
      (or (< (caddr p) (xyzt:get 'v-zmin cfg)) (> (caddr p) (xyzt:get 'v-zmax cfg)))) "FUERA_Z")
    (T nil)))
(defun xyzt:welford (state z / n mean m2 delta)
  (setq n (1+ (car state)) delta (- z (cadr state)) mean (+ (cadr state) (/ delta n))
        m2 (+ (caddr state) (* delta (- z mean))))
  (list n mean m2))
(defun xyzt:stat-add (s p / z)
  (setq z (caddr p))
  (list (xyzt:welford (car s) z)
    (if (cadr s) (min (cadr s) z) z) (if (caddr s) (max (caddr s) z) z)
    (if (nth 3 s) (mapcar 'min (nth 3 s) p) p)
    (if (nth 4 s) (mapcar 'max (nth 4 s) p) p)))
(defun xyzt:empty-stat () (list '(0 0.0 0.0) nil nil nil nil))
(defun xyzt:std (s / w) (setq w (car s))
  (if (> (car w) 1) (sqrt (max 0.0 (/ (caddr w) (1- (car w))))) 0.0))
(defun xyzt:analyze (cfg poly sep / f s ln p reason raw eligible counts skipped invalid)
  (setq f (xyzt:open-input (xyzt:get "file" cfg)) ln 0 raw (xyzt:empty-stat)
        eligible (xyzt:empty-stat) counts nil skipped 0 invalid 0)
  (while (setq s (xyzt:read-line f))
    (setq ln (1+ ln))
    (cond
      ((or (<= ln (atoi (xyzt:get "skip" cfg))) (xyzt:comment s) (xyzt:header s cfg sep))
        (setq skipped (1+ skipped)))
      ((not (setq p (xyzt:line s cfg sep))) (setq invalid (1+ invalid)))
      (T
        (setq raw (xyzt:stat-add raw p) reason (xyzt:filter-reason p cfg poly))
        (if reason (setq counts (xyzt:put reason (1+ (cond ((xyzt:get reason counts)) (T 0))) counts))
          (setq eligible (xyzt:stat-add eligible p)))))
    (if (= 0 (rem ln 20000)) (princ (strcat "\rXYZ-Tools analizando " (itoa ln) " lineas..."))))
  (xyzt:close-input)
  (list (cons 'raw raw) (cons 'eligible eligible) (cons 'lines ln)
        (cons 'skip skipped) (cons 'invalid invalid) (cons 'filtered counts)))
(defun xyzt:stats-text (stats / raw sel)
  (setq raw (xyzt:get 'raw stats) sel (xyzt:get 'eligible stats))
  (strcat "Archivo: " (itoa (car (car raw))) " XYZ validos; "
    (itoa (xyzt:get 'invalid stats)) " invalidos; " (itoa (xyzt:get 'skip stats)) " omitidos.\n"
    "Dentro de filtros: " (itoa (car (car sel)))
    (if (> (car (car sel)) 0)
      (strcat " | Z " (rtos (cadr sel) 2 3) " a " (rtos (caddr sel) 2 3)
        "\nPromedio Z: " (rtos (cadr (car sel)) 2 3) " | Desv. muestral: " (rtos (xyzt:std sel) 2 3)
        "\nX: " (rtos (car (nth 3 sel)) 2 3) " a " (rtos (car (nth 4 sel)) 2 3)
        " | Y: " (rtos (cadr (nth 3 sel)) 2 3) " a " (rtos (cadr (nth 4 sel)) 2 3)) "")))

;;; Clases: [inferior,superior), ultimo incluye maximo. Maximo 100.
(defun xyzt:nice-step (raw / scale choice candidate)
  (if (<= raw 0.0) 0.5
    (progn
      (setq scale 1.0 choice nil)
      (while (> raw (* 5.0 scale)) (setq scale (* scale 10.0)))
      (while (< raw (* 0.5 scale)) (setq scale (/ scale 10.0)))
      (foreach candidate '(0.5 1.0 2.0 2.5 5.0)
        (if (and (null choice) (<= raw (* candidate scale))) (setq choice (* candidate scale))))
      choice)))
(defun xyzt:classes (cfg stats lot / s lo hi step count mode i out upper)
  (setq s (xyzt:get 'eligible stats) lo (cadr s) hi (caddr s) mode (atoi (xyzt:get "classmode" cfg)))
  (setq step
    (if (= mode 0)
      (if (equal lo hi 1e-12) (xyzt:get 'v-step cfg)
        (xyzt:nice-step (/ (- hi lo) (atoi (xyzt:get "classes" cfg)))))
      (xyzt:get 'v-step cfg)))
  (if (= mode 2) (setq lo (xyzt:get 'v-base cfg) hi (xyzt:get 'v-top cfg)))
  ;; Limites completos y multiplos del intervalo, tambien para cotas negativas.
  (setq lo (* step (xyzt:floor (+ (/ lo step) 1e-10)))
        hi (* step (xyzt:ceil (/ hi step)))
        count (max 1 (xyzt:ceil (/ (- hi lo) step))) hi (+ lo (* count step)))
  (if (> count 100) (xyzt:fail "Mas de 100 intervalos. Aumente el intervalo o use Automatico redondeado."))
  (setq i 0 out nil)
  (repeat count
    (setq upper (+ lo (* (1+ i) step)))
    (setq out (cons (list (strcat (xyzt:get "prefix" cfg) "_" lot "_" (if (< i 9) "0" "") (itoa (1+ i)))
      (+ lo (* i step)) upper (xyzt:rgb-ccn (1+ i) count (= (xyzt:get "palette" cfg) "1"))) out))
    (setq i (1+ i)))
  (xyzt:add-tails (reverse out) cfg lot))
(defun xyzt:ceil (v / n) (setq n (fix v)) (if (> v (+ n 1e-10)) (1+ n) n))
(defun xyzt:tail-kind (info) (nth 4 info))
(defun xyzt:class-label (info)
  (cond
    ((eq (xyzt:tail-kind info) 'UNDER) (strcat "<< " (rtos (nth 2 info) 2 2)))
    ((eq (xyzt:tail-kind info) 'OVER) (strcat ">> " (rtos (nth 1 info) 2 2)))
    (T (strcat (rtos (nth 1 info) 2 2) " a " (rtos (nth 2 info) 2 2)))))
(defun xyzt:class-bound (info index)
  (if (or (and (= index 1) (eq (xyzt:tail-kind info) 'UNDER))
          (and (= index 2) (eq (xyzt:tail-kind info) 'OVER))) ""
    (xyzt:nstr (nth index info))))
(defun xyzt:add-tails (classes cfg lot / count index out info low high)
  (setq low (nth 1 (car classes)) high (nth 2 (last classes))
        count (+ (length classes) 2) index 2 out nil)
  (foreach info classes
    (setq out (cons (list (car info) (nth 1 info) (nth 2 info)
      (xyzt:rgb-ccn index count (= (xyzt:get "palette" cfg) "1"))) out) index (1+ index)))
  (append
    (list (list (strcat (xyzt:get "prefix" cfg) "_" lot "_BAJO") -1e99 low
      (xyzt:rgb-ccn 1 count (= (xyzt:get "palette" cfg) "1")) 'UNDER))
    (reverse out)
    (list (list (strcat (xyzt:get "prefix" cfg) "_" lot "_ALTO") high 1e99
      (xyzt:rgb-ccn count count (= (xyzt:get "palette" cfg) "1")) 'OVER))))
(defun xyzt:class-index (z classes outside / i found info kind next)
  (setq i 0 found nil)
  (foreach info classes
    (setq kind (xyzt:tail-kind info) next (nth (1+ i) classes))
    (if (null found)
      (cond
        ((eq kind 'UNDER) (if (and (= outside "1") (< z (nth 2 info))) (setq found i)))
        ((eq kind 'OVER) (if (and (= outside "1") (> z (nth 1 info))) (setq found i)))
        ((and (>= z (nth 1 info))
              (or (< z (nth 2 info))
                  (and (or (not next) (eq (xyzt:tail-kind next) 'OVER)) (<= z (nth 2 info)))))
          (setq found i))))
    (setq i (1+ i)))
  ;; Compatibilidad para listas antiguas sin clases abiertas.
  (if (and (null found) (= outside "1") (not (eq (xyzt:tail-kind (car classes)) 'UNDER)))
    (setq found (if (< z (nth 1 (car classes))) 0 (1- (length classes))))) found)
;;; Indice hash en SafeArray de cadenas: sin Scripting.Dictionary ni librerias
;;; COM externas. 65521 cubetas; cada cubeta contiene solo sus colisiones.
(defun xyzt:new-dict (/ obj)
  (setq obj (vl-catch-all-apply 'vlax-make-safearray (list 8 (cons 0 65520))))
  (if (vl-catch-all-error-p obj)
    (xyzt:fail "No disponible indice espacial SafeArray. Use Sin reduccion/Cada N y sin duplicados."))
  obj)
(defun xyzt:unvariant (v)
  (if (eq (type v) 'VARIANT) (vlax-variant-value v) v))
(defun xyzt:hash (key / i code)
  (setq i 1 code 0)
  (while (<= i (strlen key))
    (setq code (rem (+ (* code 31) (ascii (substr key i 1))) 65521) i (1+ i))) code)
(defun xyzt:bucket (d key / value)
  (setq value (xyzt:unvariant (vlax-safearray-get-element d (xyzt:hash key))))
  (if (and (eq (type value) 'STR) (/= value "")) (read value) nil))
(defun xyzt:dict-get (d key) (cadr (assoc key (xyzt:bucket d key))))
(defun xyzt:serialize (v / out item)
  (cond
    ((null v) "nil")
    ((eq (type v) 'REAL) (rtos v 2 16))
    ((eq (type v) 'INT) (itoa v))
    ((eq (type v) 'LIST)
      (setq out "(")
      (foreach item v (setq out (strcat out (xyzt:serialize item) " ")))
      (strcat out ")"))
    (T (vl-prin1-to-string v))))
(defun xyzt:dict-set (d key val / bucket previous)
  (setq bucket (xyzt:bucket d key) previous (assoc key bucket))
  (setq bucket (if previous (subst (list key val) previous bucket) (cons (list key val) bucket)))
  (vlax-safearray-put-element d (xyzt:hash key) (xyzt:serialize bucket)))
(defun xyzt:cell (p size) (list (xyzt:floor (/ (car p) size)) (xyzt:floor (/ (cadr p) size))))
(defun xyzt:cell3 (p size)
  (append (xyzt:cell p size) (list (xyzt:floor (/ (caddr p) size)))))
(defun xyzt:cellkey (cell)
  (strcat (rtos (car cell) 2 0) ":" (rtos (cadr cell) 2 0)
    (if (caddr cell) (strcat ":" (rtos (caddr cell) 2 0)) "")))
(defun xyzt:distance2 (a b dims / dx dy dz)
  (setq dx (- (car a) (car b)) dy (- (cadr a) (cadr b))
        dz (if (= dims 3) (- (caddr a) (caddr b)) 0.0))
  (+ (* dx dx) (* dy dy) (* dz dz)))
(defun xyzt:near (dict p size dims / cell dx dy dz vals found q neighbor)
  (setq cell (if (= dims 3) (xyzt:cell3 p size) (xyzt:cell p size)) dx -1 found nil)
  (repeat 3
    (setq dy -1)
    (repeat 3
      (setq dz (if (= dims 3) -1 0))
      (repeat (if (= dims 3) 3 1)
        (setq neighbor (list (+ (car cell) dx) (+ (cadr cell) dy)))
        (if (= dims 3) (setq neighbor (append neighbor (list (+ (caddr cell) dz)))))
        (setq vals (xyzt:dict-get dict (xyzt:cellkey neighbor)))
        (foreach q vals (if (< (xyzt:distance2 p q dims) (* size size)) (setq found T)))
        (setq dz (1+ dz)))
      (setq dy (1+ dy)))
    (setq dx (1+ dx))) found)
(defun xyzt:store-near (dict p size dims / key)
  (setq key (xyzt:cellkey (if (= dims 3) (xyzt:cell3 p size) (xyzt:cell p size))))
  (xyzt:dict-set dict key (cons p (xyzt:dict-get dict key))))
(defun xyzt:exact-key (p) (xyzt:serialize p))
(defun xyzt:duplicate (d p cfg / mode key tol found)
  (setq mode (xyzt:get "duplicates" cfg))
  (cond
    ((= mode "0") nil)
    ((= mode "1")
      (setq key (xyzt:exact-key p) found (xyzt:dict-get d key))
      (if (not found) (xyzt:dict-set d key T)) found)
    (T (setq tol (xyzt:get 'v-tol cfg) found (xyzt:near d p tol 3))
       (if (not found) (xyzt:store-near d p tol 3)) found)))
(defun xyzt:grid-better (new old mode)
  (or (not old)
      (and (= mode 3) (> (caddr (car new)) (caddr (car old))))
      (and (= mode 4) (< (caddr (car new)) (caddr (car old))))))

;;; XData ligero: lote y linea fuente. El resto se registra una vez en XRECORD.
(defun xyzt:tag (lot line)
  (list -3 (list "IXYZ7" (cons 1000 lot) (cons 1071 line))))
(defun xyzt:lot-of (en / data app)
  (setq data (entget en '("IXYZ7")) app (cadr (assoc -3 data)))
  (if (equal (car app) "IXYZ7") (cdr (assoc 1000 (cdr app))) nil))
(defun xyzt:lot-selection (lot / ss out i en)
  (setq ss (ssget "_X" '((-3 ("IXYZ7")))) out nil)
  (if ss
    (progn (setq i 0)
      (repeat (sslength ss)
        (setq en (ssname ss (float i)))
        (if (= lot (xyzt:lot-of en)) (setq out (cons en out)))
        (setq i (1+ i))))) out)
(defun xyzt:root (/ found en)
  (if (setq found (dictsearch (namedobjdict) "IXYZ7_LOTES")) (cdr (assoc -1 found))
    (progn (setq en (entmakex '((0 . "DICTIONARY") (100 . "AcDbDictionary") (280 . 0) (281 . 1))))
      (if (not en) (xyzt:fail "No se pudo crear el registro de lotes."))
      (dictadd (namedobjdict) "IXYZ7_LOTES" en))))
(defun xyzt:chunk-record (data / out item value)
  (setq out nil)
  (foreach item data
    (if (and (= (car item) 1) (> (strlen (cdr item)) 250))
      (progn
        (setq value (cdr item))
        (while (> (strlen value) 250)
          (setq out (cons (cons 1 (substr value 1 250)) out) value (substr value 251)))
        (setq out (cons (cons 1 value) out)))
      (setq out (cons item out))))
  (reverse out))
(defun xyzt:record (lot cfg classes stats imported counts / data pair item en root)
  (setq data (list '(0 . "XRECORD") '(100 . "AcDbXrecord") '(280 . 1)
    (cons 1 (strcat "XYZ-Tools " *xyzt:version* " | " lot))
    (cons 1 (strcat "FUENTE=" (xyzt:get "file" cfg)))
    (cons 1 (strcat "CREADO=" (rtos (getvar "CDATE") 2 6)))
    (cons 1 (strcat "IMPORTADOS=" (itoa imported)))
    (cons 1 "SALIDA=metros WCS; Z=elevacion; sin reproyeccion")))
  (foreach pair cfg
    (if (and (eq (type (car pair)) 'STR) (/= (car pair) "file"))
      (setq data (append data (list (cons 1 (strcat (car pair) "=" (cdr pair))))))))
  (if *xyzt:polygon*
    (setq data (append data (list (cons 1 (strcat "POLIGONO_WCS=" (xyzt:serialize *xyzt:polygon*)))))))
  (if *xyzt:replace*
    (setq data (append data (list (cons 1 (strcat "REEMPLAZA_LOTE=" *xyzt:replace*))))))
  (foreach item classes
    (setq data (append data (list (cons 1 (strcat "CLASE=" (car item) ";"
      (xyzt:class-bound item 1) ";" (xyzt:class-bound item 2) ";" (xyzt:hex (nth 3 item))))))))
  (foreach pair counts
    (setq data (append data (list (cons 1 (strcat "CONTADOR=" (car pair) ";" (itoa (cdr pair))))))))
  (setq data (xyzt:chunk-record data))
  (setq root (xyzt:root) en (entmakex data))
  (if (or (not en) (not (dictadd root lot en))) (xyzt:fail "No se pudo registrar el lote."))
  en)
(defun xyzt:lot-id (/ base lot i root)
  (setq base (strcat "L" (vl-string-translate "." "_" (rtos (getvar "CDATE") 2 6)))
        lot base i 1 root (dictsearch (namedobjdict) "IXYZ7_LOTES"))
  (if root (setq root (cdr (assoc -1 root))))
  (while (and root (dictsearch root lot)) (setq lot (strcat base "_" (itoa i)) i (1+ i))) lot)
(defun xyzt:layer (name rgb / en)
  (if (tblsearch "LAYER" name) (xyzt:fail "Colision inesperada de capa; cambie prefijo."))
  (setq en (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
      '(100 . "AcDbLayerTableRecord") (cons 2 name) '(70 . 0) '(62 . 7)
      (cons 420 (xyzt:tc rgb)) '(6 . "Continuous"))))
  (if (not en) (xyzt:fail (strcat "No se pudo crear capa " name)))
  (setq *xyzt:newlayers* (cons name *xyzt:newlayers*)) en)
(defun xyzt:point (p line lot layer)
  (xyzt:make (list '(0 . "POINT") '(100 . "AcDbEntity") (cons 8 layer) '(62 . 256)
    '(100 . "AcDbPoint") (cons 10 p) (xyzt:tag lot line))))
(defun xyzt:bump (key counts) (xyzt:put key (1+ (cond ((xyzt:get key counts)) (T 0))) counts))
(defun xyzt:csv-quote (s / i out ch)
  (setq i 1 out "\"")
  (while (<= i (strlen s))
    (setq ch (substr s i 1) out (strcat out (if (= ch "\"") "\"\"" ch)) i (1+ i)))
  (strcat out "\""))
(defun xyzt:log (line reason s)
  (if *xyzt:log* (write-line (strcat (itoa line) ";" reason ";" (xyzt:csv-quote s)) *xyzt:log*)))
(defun xyzt:emit (p ln lot classes cfg / index en c)
  (setq index (xyzt:class-index (caddr p) classes (xyzt:get "outside" cfg)))
  (if (null index)
    (progn (setq *xyzt:counts* (xyzt:bump "FUERA_CLASES" *xyzt:counts*))
      (xyzt:log ln "FUERA_CLASES" (vl-prin1-to-string p)))
    (progn
      (setq c (nth index classes) en (xyzt:point p ln lot (car c)))
      (if (not en) (xyzt:fail (strcat "Fallo creando POINT en linea " (itoa ln))))
      (if (= (xyzt:get "labels" cfg) "1") (xyz:label p ln lot c cfg))
      (setq *xyzt:imported* (1+ *xyzt:imported*)
            *xyzt:classcounts* (xyzt:bump (car c) *xyzt:classcounts*)
            *xyzt:importstats* (xyzt:stat-add *xyzt:importstats* p)))))
(defun xyzt:import (cfg poly sep classes lot / f s ln p reason mode n grid near dup keys key old val eligible)
  (setq mode (atoi (xyzt:get "reduce" cfg))
        grid (if (member mode '(2 3 4)) (xyzt:new-dict) nil)
        near (if (= mode 5) (xyzt:new-dict) nil)
        dup (if (/= (xyzt:get "duplicates" cfg) "0") (xyzt:new-dict) nil)
        f (xyzt:open-input (xyzt:get "file" cfg)) ln 0 eligible 0 keys nil)
  (setq *xyzt:counts* nil *xyzt:classcounts* nil *xyzt:imported* 0 *xyzt:importstats* (xyzt:empty-stat))
  (while (setq s (xyzt:read-line f))
    (setq ln (1+ ln))
    (cond
      ((or (<= ln (atoi (xyzt:get "skip" cfg))) (xyzt:comment s) (xyzt:header s cfg sep))
        (setq *xyzt:counts* (xyzt:bump "OMITIDAS" *xyzt:counts*)))
      ((not (setq p (xyzt:line s cfg sep)))
        (setq *xyzt:counts* (xyzt:bump "INVALIDAS" *xyzt:counts*)) (xyzt:log ln "XYZ_INVALIDO" s))
      ((setq reason (xyzt:filter-reason p cfg poly))
        (setq *xyzt:counts* (xyzt:bump reason *xyzt:counts*)) (xyzt:log ln reason s))
      ((and (= (xyzt:get "outside" cfg) "0") (null (xyzt:class-index (caddr p) classes "0")))
        (setq *xyzt:counts* (xyzt:bump "FUERA_CLASES" *xyzt:counts*)) (xyzt:log ln "FUERA_CLASES" s))
      ((and dup (xyzt:duplicate dup p cfg))
        (setq *xyzt:counts* (xyzt:bump "DUPLICADOS" *xyzt:counts*)) (xyzt:log ln "DUPLICADO" s))
      (T
        (setq eligible (1+ eligible))
        (cond
          ((and (= mode 1) (/= (rem (1- eligible) (atoi (xyzt:get "every" cfg))) 0))
            (setq *xyzt:counts* (xyzt:bump "REDUCIDOS" *xyzt:counts*)) (xyzt:log ln "CADA_N" s))
          ((member mode '(2 3 4))
            (setq key (xyzt:cellkey (xyzt:cell p (xyzt:get 'v-spacing cfg)))
                  old (xyzt:dict-get grid key) val (list p ln))
            (if (not old) (setq keys (cons key keys))
              (progn
                (setq *xyzt:counts* (xyzt:bump "REDUCIDOS" *xyzt:counts*))
                (if (xyzt:grid-better val old mode)
                  (xyzt:log (cadr old) "CELDA_REEMPLAZADO" (vl-prin1-to-string (car old)))
                  (xyzt:log ln "CELDA_DESCARTADO" s))))
            (if (xyzt:grid-better val old mode) (xyzt:dict-set grid key val)))
          ((and (= mode 5) (xyzt:near near p (xyzt:get 'v-spacing cfg) 2))
            (setq *xyzt:counts* (xyzt:bump "REDUCIDOS" *xyzt:counts*)) (xyzt:log ln "DISTANCIA_XY" s))
          (T (if near (xyzt:store-near near p (xyzt:get 'v-spacing cfg) 2))
             (xyzt:emit p ln lot classes cfg)))))
    (if (= 0 (rem ln 10000))
      (princ (strcat "\rIXYZ: " (itoa ln) " lineas | " (itoa *xyzt:imported*) " puntos creados..."))))
  (xyzt:close-input)
  (if grid
    (foreach key (reverse keys)
      (setq val (xyzt:dict-get grid key)) (xyzt:emit (car val) (cadr val) lot classes cfg)))
  (setq *xyzt:counts* (xyzt:put "LINEAS" ln *xyzt:counts*)
        *xyzt:counts* (xyzt:put "IMPORTADOS" *xyzt:imported* *xyzt:counts*)))

;;; Leyenda: bloque 2D en plano WCS XY a Z=0; punto de insercion del UCS a WCS.
;;; SOLID relleno y texto neutro para legibilidad. Todo etiquetado por lote.
(defun xyzt:text (p h s layer lot)
  (xyzt:make (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 layer) '(62 . 7)
    '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 s) '(7 . "Standard")
    (xyzt:tag lot 0))))
(defun xyzt:legend (classes cfg lot base / name h x y info color count)
  (setq name (strcat (xyzt:get "prefix" cfg) "_" lot "_LEYENDA")
        h (xyzt:get 'v-height cfg) x (car base) y (cadr base))
  (xyzt:layer name '(255 255 255))
  (xyzt:text (list x y 0.0) (* h 1.25) (strcat "XYZ-Tools " lot " | COTAS (m)") name lot)
  (setq y (- y (* h 2.2)))
  (xyzt:text (list x y 0.0) h (strcat "Ref. vertical: " (xyzt:get "ref" cfg)) name lot)
  (setq y (- y (* h 2.0)))
  (xyzt:text (list x y 0.0) h (strcat "Sistema: " (xyzt:get "crs" cfg)) name lot)
  (setq y (- y (* h 2.0)))
  (foreach info (reverse classes)
    (setq color (xyzt:tc (nth 3 info)) count (cond ((xyzt:get (car info) *xyzt:classcounts*)) (T 0)))
    (xyzt:make (list '(0 . "SOLID") '(100 . "AcDbEntity") (cons 8 name) (cons 420 color)
      '(100 . "AcDbTrace") (cons 10 (list x y 0.0)) (cons 11 (list (+ x (* 2 h)) y 0.0))
      (cons 12 (list x (+ y h) 0.0)) (cons 13 (list (+ x (* 2 h)) (+ y h) 0.0))
      (xyzt:tag lot 0)))
    (xyzt:text (list (+ x (* 3 h)) y 0.0) h
      (strcat (xyzt:class-label info)
        " | " (itoa count) " pts | " (rtos (xyzt:percent count *xyzt:imported*) 2 2) "%") name lot)
    (setq y (- y (* h 1.8)))) name)
(defun xyzt:report (path cfg sep lot classes stats seconds / f info n pair sel)
  (setq f (open path "w"))
  (if (not f) (xyzt:fail "No se pudo crear el CSV de resultados."))
  (setq *xyzt:out* f)
  (write-line "Seccion;Dato;Valor;Z_min;Z_max;Color_RGB;Puntos;Porcentaje" f)
  (foreach pair (list (cons "Version" *xyzt:version*) (cons "Lote" lot)
      (cons "Archivo" (xyzt:get "file" cfg)) (cons "Referencia_vertical" (xyzt:get "ref" cfg))
      (cons "Sistema_declarado" (xyzt:get "crs" cfg)) (cons "Salida" "Metros WCS; no reproyectado")
      (cons "Separador" (if (= sep (chr 9)) "TAB" sep)) (cons "Segundos" (xyzt:nstr seconds)))
    (write-line (strcat "METADATO;" (car pair) ";" (xyzt:csv-quote (cdr pair))) f))
  (foreach pair cfg
    (if (eq (type (car pair)) 'STR)
      (write-line (strcat "CONFIG;" (car pair) ";" (xyzt:csv-quote (cdr pair))) f)))
  (if *xyzt:polygon*
    (write-line (strcat "METADATO;Poligono_WCS;" (xyzt:csv-quote (xyzt:serialize *xyzt:polygon*))) f))
  (foreach pair *xyzt:counts*
    (write-line (strcat "CONTADOR;" (car pair) ";" (itoa (cdr pair))) f))
  (foreach info classes
    (setq n (cond ((xyzt:get (car info) *xyzt:classcounts*)) (T 0)))
    (write-line (strcat "CLASE;" (xyzt:csv-quote (car info)) ";;" (xyzt:class-bound info 1) ";"
      (xyzt:class-bound info 2) ";" (xyzt:hex (nth 3 info)) ";" (itoa n) ";"
      (xyzt:nstr (xyzt:percent n *xyzt:imported*))) f))
  (foreach pair (list (cons "ARCHIVO" (xyzt:get 'raw stats)) (cons "FILTROS" (xyzt:get 'eligible stats))
                     (cons "IMPORTADOS" *xyzt:importstats*))
    (setq sel (cdr pair))
    (if (> (car (car sel)) 0)
      (progn
        (write-line (strcat "ESTADISTICA;" (car pair) "_Z_MEDIA;" (xyzt:nstr (cadr (car sel)))) f)
        (write-line (strcat "ESTADISTICA;" (car pair) "_Z_DESV_MUESTRAL;" (xyzt:nstr (xyzt:std sel))) f)
        (write-line (strcat "ESTADISTICA;" (car pair) "_XYZ_MIN;" (xyzt:csv-quote (xyzt:serialize (nth 3 sel)))) f)
        (write-line (strcat "ESTADISTICA;" (car pair) "_XYZ_MAX;" (xyzt:csv-quote (xyzt:serialize (nth 4 sel)))) f))))
  (close f) (setq *xyzt:out* nil))

;;; Aislamiento reversible, almacenado por documento en memoria de sesion.
(defun xyzt:doc-key () (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
(defun xyzt:isolate (names / doc layers ly name snapshot key result)
  (setq key (xyzt:doc-key) doc (vla-get-ActiveDocument (vlax-get-acad-object))
        layers (vla-get-Layers doc) snapshot nil)
  (vlax-for ly layers
    (setq name (vla-get-Name ly))
    (setq snapshot (cons (cons name (vla-get-LayerOn ly)) snapshot)))
  (if (not (assoc key *xyzt:layerstates*))
    (setq *xyzt:layerstates* (cons (cons key snapshot) *xyzt:layerstates*)))
  (vlax-for ly layers
    (setq name (vla-get-Name ly))
    (setq result (vl-catch-all-apply 'vla-put-LayerOn
      (list ly (if (or (member name names) (= name (getvar "CLAYER"))) :vlax-true :vlax-false))))
    (if (vl-catch-all-error-p result) (princ (strcat "\nNo se cambio visibilidad: " name))))
  (princ "\nVisibilidad guardada. XYZRESTAURAR restaura las capas en esta sesion."))
(defun c:XYZRESTAURAR (/ key state doc layers pair ly res)
  (setq key (xyzt:doc-key) state (assoc key *xyzt:layerstates*))
  (if (not state) (princ "\nNo hay aislamiento XYZ-Tools pendiente en este documento.")
    (progn
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) layers (vla-get-Layers doc))
      (foreach pair (cdr state)
        (if (tblsearch "LAYER" (car pair))
          (progn
            (setq ly (vla-Item layers (car pair)))
            (setq res (vl-catch-all-apply 'vla-put-LayerOn (list ly (cdr pair))))
            (if (vl-catch-all-error-p res) (princ (strcat "\nNo restaurada: " (car pair)))))))
      (setq *xyzt:layerstates* (vl-remove state *xyzt:layerstates*))
      (vla-Regen doc 1) (princ "\nVisibilidad restaurada."))) (princ))
(defun xyzt:release () (setq *xyzt:objects* nil))
(defun xyzt:cleanup (/ file)
  (xyzt:close-input)
  (if *xyzt:out* (progn (close *xyzt:out*) (setq *xyzt:out* nil)))
  (if *xyzt:log* (progn (close *xyzt:log*) (setq *xyzt:log* nil)))
  (xyzt:release)
  (foreach file *xyz:workfiles* (if (findfile file) (vl-file-delete file)))
  (setq *xyz:workfiles* nil)
  (if (and *xyzt:dclid* (>= *xyzt:dclid* 0)) (unload_dialog *xyzt:dclid*))
  (setq *xyzt:dclid* nil)
  (if *xyzt:dclfile* (vl-file-delete *xyzt:dclfile*))
  (setq *xyzt:dclfile* nil))
(defun xyzt:rollback (lot / en name obj root)
  (if lot
    (progn
      (foreach en (xyzt:lot-selection lot) (vl-catch-all-apply 'entdel (list en)))
      (if (setq root (dictsearch (namedobjdict) "IXYZ7_LOTES"))
        (if (setq en (dictremove (cdr (assoc -1 root)) lot)) (entdel en)))))
  (foreach en *xyzt:deleted* (vl-catch-all-apply 'entdel (list en)))
  (foreach name *xyzt:newlayers*
    (if (tblsearch "LAYER" name)
      (progn
        (setq obj (vla-Item (vla-get-Layers (vla-get-ActiveDocument (vlax-get-acad-object))) name))
        (vl-catch-all-apply 'vla-Delete (list obj)))))
  (setq *xyzt:deleted* nil *xyzt:newlayers* nil))

