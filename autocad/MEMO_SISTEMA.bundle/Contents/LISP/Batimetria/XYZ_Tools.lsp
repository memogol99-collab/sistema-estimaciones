;;; ============================================================================
;;; Funciones conservadas/ampliadas de XYZ-Tools 2.3: etiquetas, procesar y unir.
;;; Procesar conserva X/Y y campos adicionales; solo transforma la columna Z.
;;; Unir genera XYZ normalizado, sin acumular todos los puntos en una lista.
;;; ============================================================================
(defun xyz:replace-index (items index value / out j item)
  (setq out nil j 0)
  (foreach item items (setq out (cons (if (= j index) value item) out) j (1+ j)))
  (reverse out))
(defun xyz:number-text (number decimals decimal / text)
  (setq text (rtos number 2 (if (= decimals -1) 16 decimals)))
  (if (= decimals -1)
    (progn
      (while (and (> (strlen text) 1) (= (substr text (strlen text) 1) "0")
                  (vl-string-search "." text))
        (setq text (substr text 1 (1- (strlen text)))))
      (if (= (substr text (strlen text) 1) ".") (setq text (substr text 1 (1- (strlen text)))))))
  (if (member text '("-0" "-0.0")) (setq text "0"))
  (if (= decimal ",") (vl-string-translate "." "," text) text))
(defun xyz:join (items sep / text item)
  (setq text nil)
  (foreach item items
    (setq text (if text (strcat text sep item) item)))
  (if text text ""))
(defun xyz:output-row (fields sep / item result)
  (setq result nil)
  (foreach item fields
    (setq result (cons (if (or (vl-string-search sep item) (vl-string-search "\"" item)
                              (and (= sep " ") (vl-string-search (chr 9) item)))
                        (xyzt:csv-quote item) item) result)))
  (xyz:join (reverse result) sep))
(defun xyz:parse-ranges (text / chunks items out vals part a b delta previous entry)
  (setq chunks (xyzt:fields text ";") out nil)
  (foreach part chunks
    (if (/= (xyzt:trim part) "")
      (progn
        (setq items (xyzt:fields part "WS"))
        (if (/= (length items) 3) (xyzt:fail "Cada rango debe tener: Z_min Z_max ajuste. Separe rangos con ;"))
        (setq a (xyzt:setting-number (car items)) b (xyzt:setting-number (cadr items))
              delta (xyzt:setting-number (caddr items)))
        (if (or (null a) (null b) (null delta) (>= a b)) (xyzt:fail "Rango invalido: requiere Z_min < Z_max y ajuste numerico."))
        (setq out (cons (list a b delta) out)))))
  (if (not out) (xyzt:fail "Ingrese al menos un rango."))
  (setq out (vl-sort out '(lambda (a b) (< (car a) (car b)))) previous nil)
  (foreach entry out
    (if (and previous (< (car entry) (cadr previous))) (xyzt:fail "Los rangos se superponen. Corrija los limites."))
    (setq previous entry)) out)
(defun xyz:transform (z mode offset ranges lo hi / entry value matched lastentry)
  (cond
    ((= mode 0) (- z))
    ((= mode 1) (+ z offset))
    ((= mode 2)
      (setq value z matched nil lastentry (last ranges))
      (foreach entry ranges
        (if (and (not matched) (>= z (car entry))
                 (or (< z (cadr entry)) (and (equal entry lastentry) (<= z (cadr entry)))))
          (setq value (+ z (caddr entry)) matched T))) value)
    ((= mode 3) (if (and (>= z lo) (<= z hi)) nil z))
    (T z)))
(defun xyz:identity-config (cfg)
  (setq cfg (xyzt:put 'xyfactor 1.0 cfg) cfg (xyzt:put 'zfactor 1.0 cfg) cfg (xyzt:put 'offset 0.0 cfg)) cfg)
(defun xyz:process-defaults (file / cfg pair)
  (setq cfg (xyzt:defaults) cfg (xyzt:put "file" file cfg))
  (foreach pair '(("operation" . "0") ("amount" . "0") ("ranges" . "-20 -10 0.1; -10 0 0.2")
      ("remove_min" . "-9999") ("remove_max" . "-9998") ("outdec" . "-1")
      ("suffix" . "_MOD") ("output" . "") ("badrows" . "0") ("import_after" . "0"))
    (setq cfg (xyzt:put (car pair) (cdr pair) cfg))) cfg)
(setq xyz:process-keys '("file" "sep" "decimal" "cx" "cy" "cz" "skip" "operation" "amount"
  "ranges" "remove_min" "remove_max" "outdec" "suffix" "output" "badrows" "import_after" "duplicates" "tol"))
(defun xyz:process-save (/ key)
  (foreach key xyz:process-keys (setq *xyz:process-ui* (xyzt:put key (get_tile key) *xyz:process-ui*))))
(defun xyz:process-exit (code) (xyz:process-save) (done_dialog code))
(defun xyz:process-dialog (/ key path)
  (if (not (new_dialog "XYZ_PROCESS" *xyzt:dclid*)) (xyzt:fail "No se pudo abrir Procesar/Unir."))
  (xyzt:fill-popup "sep" '("Automatico" "Espacios/TAB" "TAB" "Punto y coma" "Coma"))
  (xyzt:fill-popup "decimal" '("Punto decimal" "Coma decimal"))
  (xyzt:fill-popup "operation" '("Invertir Z" "Offset constante Z" "Ajustar Z por rangos" "Eliminar rango Z" "Unir archivos XYZ" "Analizar Z minima / maxima"))
  (xyzt:fill-popup "badrows" '("Conservar filas no numericas (procesar)" "Omitir filas no numericas (procesar)"))
  (xyzt:fill-popup "duplicates" '("Conservar duplicados (union)" "Eliminar XYZ exactos (union)" "Tolerancia distancia 3D (union)"))
  (foreach key xyz:process-keys (set_tile key (xyzt:get key *xyz:process-ui*)))
  (start_list "files") (foreach path *xyz:files* (add_list path)) (end_list)
  (set_tile "process_status" (strcat "Archivos de union: " (itoa (length *xyz:files*)) ". Rangos: [min,max); ultimo incluye max."))
  (action_tile "pick_input" "(xyz:process-exit 2)")
  (action_tile "add_file" "(xyz:process-exit 3)")
  (action_tile "remove_file" "(setq *xyz:remove-index* (atoi (get_tile \"files\")))(xyz:process-exit 4)")
  (action_tile "pick_output" "(xyz:process-exit 5)")
  (action_tile "preview" "(xyz:process-exit 6)")
  (action_tile "accept" "(xyz:process-exit 1)")
  (action_tile "cancel" "(xyz:process-exit 0)")
  (start_dialog))
(defun xyz:validate-process (cfg files / key value mode file)
  (setq mode (atoi (xyzt:get "operation" cfg)))
  (if (= mode 4)
    (progn
      (if (< (length files) 2) (xyzt:fail "Agregue al menos dos archivos a la union."))
      (foreach file files (if (not (findfile file)) (xyzt:fail (strcat "No existe: " file))))
      (setq cfg (xyzt:put "file" (car files) cfg))))
  (setq cfg (xyzt:validate cfg) cfg (xyz:identity-config cfg))
  (foreach key '("amount" "remove_min" "remove_max" "outdec")
    (setq value (xyzt:setting-number (xyzt:get key cfg)))
    (if (or (null value) (> (abs value) 1e10)) (xyzt:fail (strcat "Valor invalido: " key)))
    (setq cfg (xyzt:put (read (strcat "p-" key)) value cfg)))
  (setq value (xyzt:get 'p-outdec cfg))
  (if (or (/= value (fix value)) (< value -1) (> value 16)) (xyzt:fail "Decimales de salida: -1 automatico o un entero de 0 a 16."))
  (if (and (= mode 3) (> (xyzt:get 'p-remove_min cfg) (xyzt:get 'p-remove_max cfg)))
    (xyzt:fail "Limites del rango a eliminar invertidos."))
  (if (= mode 2) (setq cfg (xyzt:put 'p-ranges (xyz:parse-ranges (xyzt:get "ranges" cfg)) cfg)))
  (if (= (xyzt:trim (xyzt:get "suffix" cfg)) "") (setq cfg (xyzt:put "suffix" "_MOD" cfg)))
  cfg)
(defun xyz:same-path (a b)
  (equal (strcase (vl-string-translate "/" "\\" a)) (strcase (vl-string-translate "/" "\\" b))))
(defun xyz:unique-path (path / folder base ext idx result)
  (setq folder (vl-filename-directory path) base (vl-filename-base path) ext (vl-filename-extension path)
        idx 1 result path)
  (if (not ext) (setq ext ".xyz" result (strcat path ext)))
  (while (findfile result)
    (setq result (strcat folder "\\" base "_" (itoa idx) ext) idx (1+ idx))) result)
(defun xyz:process-output (cfg files / path file base)
  (setq path (xyzt:get "output" cfg))
  (if (= path "")
    (setq path (strcat (vl-filename-directory (xyzt:get "file" cfg)) "\\"
      (vl-filename-base (xyzt:get "file" cfg)) (if (= (xyzt:get "operation" cfg) "4") "_UNIDO" (xyzt:get "suffix" cfg)) ".xyz")))
  (foreach file files
    (if (xyz:same-path path file) (xyzt:fail "La salida coincide con un original. Elija otro nombre.")))
  (if (not (vl-file-directory-p (vl-filename-directory path))) (xyzt:fail "No existe la carpeta de salida."))
  (xyz:unique-path path))
(defun xyz:control (kind file line reason value)
  (write-line (strcat kind ";" (xyzt:csv-quote file) ";" (itoa line) ";" reason ";" (xyzt:csv-quote value)) *xyzt:log*))
(defun xyz:signature (file) (list (vl-file-size file) (vl-file-systime file)))
(defun xyz:process-engine (cfg files output / temp control reporttemp f file per sep s ln p fields z value
                              mode decimals delim total written invalid removed duplicates skipped dup source-signature count result)
  (setq mode (atoi (xyzt:get "operation" cfg)) decimals (fix (xyzt:get 'p-outdec cfg))
        total 0 written 0 invalid 0 removed 0 duplicates 0 skipped 0
        temp (vl-filename-mktemp "xyzt_data_" (vl-filename-directory output) ".tmp")
        control (xyz:unique-path (strcat (vl-filename-directory output) "\\" (vl-filename-base output) "_CONTROL.csv"))
        reporttemp (vl-filename-mktemp "xyzt_control_" (vl-filename-directory output) ".tmp"))
  (setq *xyz:workfiles* (list temp reporttemp))
  (setq *xyzt:out* (open temp "w") *xyzt:log* (open reporttemp "w"))
  (if (or (not *xyzt:out*) (not *xyzt:log*)) (xyzt:fail "No se pudo crear salida temporal/control. Revise permisos de carpeta."))
  (write-line "Seccion;Archivo;Linea;Motivo;Valor" *xyzt:log*)
  (xyz:control "METADATO" "" 0 "VERSION" *xyzt:version*)
  (foreach result cfg
    (if (eq (type (car result)) 'STR) (xyz:control "CONFIG" "" 0 (car result) (cdr result))))
  (setq dup (if (and (= mode 4) (/= (xyzt:get "duplicates" cfg) "0")) (xyzt:new-dict) nil))
  (foreach file files
    (setq per (xyzt:put "file" file cfg) source-signature (xyz:signature file)
          sep (xyzt:detect per) f (xyzt:open-input file) ln 0 count 0)
    (setq delim (cond ((= sep "WS") " ") (T sep)))
    (while (setq s (xyzt:read-line f))
      (setq ln (1+ ln) total (1+ total))
      (cond
        ((or (<= ln (atoi (xyzt:get "skip" cfg))) (xyzt:comment s) (xyzt:header s per sep))
          (setq skipped (1+ skipped))
          (if (/= mode 4) (write-line s *xyzt:out*)))
        ((not (setq p (xyzt:line s per sep)))
          (setq invalid (1+ invalid)) (xyz:control "INCIDENCIA" file ln "XYZ_INVALIDO" s)
          (if (and (/= mode 4) (= (xyzt:get "badrows" cfg) "0")) (write-line s *xyzt:out*)))
        ((and dup (xyzt:duplicate dup p per))
          (setq duplicates (1+ duplicates)) (xyz:control "INCIDENCIA" file ln "DUPLICADO" s))
        (T
          (setq z (caddr p) value (xyz:transform z mode (xyzt:get 'p-amount cfg) (xyzt:get 'p-ranges cfg)
                                    (xyzt:get 'p-remove_min cfg) (xyzt:get 'p-remove_max cfg)))
          (if (null value)
            (progn (setq removed (1+ removed)) (xyz:control "INCIDENCIA" file ln "ELIMINADO_RANGO_Z" s))
            (progn
              (if (= mode 4)
                (write-line (xyz:join (mapcar '(lambda (v) (xyz:number-text v decimals ".")) p) " ") *xyzt:out*)
                (progn
                  (setq fields (xyzt:fields s sep)
                        fields (xyz:replace-index fields (1- (atoi (xyzt:get "cz" cfg)))
                          (xyz:number-text value decimals (xyzt:decimal per))))
                  (write-line (xyz:output-row fields delim) *xyzt:out*)))
              (setq written (1+ written) count (1+ count))))))
      (if (= 0 (rem total 10000)) (princ (strcat "\rXYZ-Tools: " (itoa total) " lineas, " (itoa written) " puntos escritos..."))))
    (xyzt:close-input)
    (if (not (equal source-signature (xyz:signature file))) (xyzt:fail "Cambio un archivo fuente durante el proceso. Se cancelo la salida."))
    (xyz:control "FUENTE" file ln "PUNTOS_ESCRITOS" (itoa count)))
  (if (= written 0) (xyzt:fail "La operacion no produjo puntos. No se publico un archivo vacio."))
  (foreach result (list (cons "LINEAS" total) (cons "PUNTOS" written) (cons "INVALIDAS" invalid)
                        (cons "ELIMINADAS" removed) (cons "DUPLICADOS" duplicates) (cons "OMITIDAS" skipped))
    (xyz:control "RESUMEN" "" 0 (car result) (itoa (cdr result))))
  (close *xyzt:out*) (setq *xyzt:out* nil) (close *xyzt:log*) (setq *xyzt:log* nil)
  ;; La publicacion solo ocurre tras cerrar y validar todos los archivos.
  (if (not (vl-file-rename reporttemp control)) (xyzt:fail "No se pudo publicar el control CSV."))
  (setq *xyz:workfiles* (cons control *xyz:workfiles*))
  (if (not (vl-file-rename temp output)) (xyzt:fail "No se pudo publicar XYZ. No se sobrescribio ningun original."))
  (setq *xyz:workfiles* nil)
  (princ (strcat "\nXYZ-Tools: " (itoa written) " puntos.\nArchivo: " output "\nControl: " control))
  (list (cons 'output output) (cons 'count written) (cons 'control control)))
(defun xyz:preview-process (cfg / sep f s ln shown p value fields text)
  (setq sep (xyzt:detect cfg) f (xyzt:open-input (xyzt:get "file" cfg)) ln 0 shown 0 text "Vista previa (no escribe archivos):\n")
  (while (and (< shown 6) (setq s (xyzt:read-line f)))
    (setq ln (1+ ln))
    (if (and (> ln (atoi (xyzt:get "skip" cfg))) (setq p (xyzt:line s cfg sep)))
      (progn
        (setq value (xyz:transform (caddr p) (atoi (xyzt:get "operation" cfg)) (xyzt:get 'p-amount cfg)
          (xyzt:get 'p-ranges cfg) (xyzt:get 'p-remove_min cfg) (xyzt:get 'p-remove_max cfg)))
        (setq text (strcat text "\nLinea " (itoa ln) " | Z " (xyzt:nstr (caddr p)) " -> "
          (if value (xyz:number-text value (fix (xyzt:get 'p-outdec cfg)) (xyzt:decimal cfg)) "ELIMINAR")))
        (setq shown (1+ shown)))))
  (xyzt:close-input) (alert text))
(defun xyz:process-flow (merge / cfg code result path validated output item n rest)
  (if (not *xyz:last-process*) (setq *xyz:last-process* (xyz:process-defaults (xyzt:get "file" *xyzt:ui*))))
  (setq *xyz:process-ui* *xyz:last-process* *xyz:files* nil code -1 result nil)
  (if (/= (xyzt:get "file" *xyzt:ui*) "")
    (setq *xyz:process-ui* (xyzt:put "file" (xyzt:get "file" *xyzt:ui*) *xyz:process-ui*)))
  (if merge
    (progn
      (setq *xyz:process-ui* (xyzt:put "operation" "4" *xyz:process-ui*))
      (if (findfile (xyzt:get "file" *xyz:process-ui*)) (setq *xyz:files* (list (xyzt:get "file" *xyz:process-ui*))))))
  (while (and (/= code 0) (/= code 1))
    (setq code (xyz:process-dialog))
    (cond
      ((= code 2)
        (setq path (getfiled "Archivo a procesar" (xyzt:get "file" *xyz:process-ui*) "xyz;txt;csv;asc" 0))
        (if path (setq *xyz:process-ui* (xyzt:put "file" path *xyz:process-ui*))))
      ((= code 3)
        (setq path (getfiled "Agregar archivo a la union" (xyzt:get "file" *xyz:process-ui*) "xyz;txt;csv;asc" 0))
        (if path
          (if (vl-some '(lambda (old) (xyz:same-path old path)) *xyz:files*)
            (alert "Ese archivo ya esta en la lista.")
            (setq *xyz:files* (append *xyz:files* (list path))))))
      ((= code 4)
        (setq rest nil n 0)
        (foreach item *xyz:files* (if (/= n *xyz:remove-index*) (setq rest (cons item rest))) (setq n (1+ n)))
        (setq *xyz:files* (reverse rest)))
      ((= code 5)
        (setq path (getfiled "Destino XYZ (si existe se usa un nombre nuevo)" (xyzt:get "output" *xyz:process-ui*) "xyz" 33))
        (if path (setq *xyz:process-ui* (xyzt:put "output" path *xyz:process-ui*))))
      ((member code '(1 6))
        (setq validated (xyzt:try 'xyz:validate-process (list *xyz:process-ui* *xyz:files*)))
        (if (vl-catch-all-error-p validated) (progn (alert (xyzt:errmsg validated)) (setq code -1))
          (progn
            (setq cfg validated)
            (if (= code 6)
              (progn
                (setq validated (xyzt:try 'xyz:preview-process (list cfg)))
                (if (vl-catch-all-error-p validated) (progn (xyzt:close-input) (alert (xyzt:errmsg validated)))))
              (if (/= (xyzt:get "operation" cfg) "5")
                (setq output (xyz:process-output cfg (if (= (xyzt:get "operation" cfg) "4") *xyz:files* (list (xyzt:get "file" cfg))))))))))))
  (setq *xyz:last-process* *xyz:process-ui*)
  (if (= code 1)
    (if (= (xyzt:get "operation" cfg) "5")
      (progn (xyz:file-z-stats cfg) (setq result nil))
      (progn
      (setq result (xyz:process-engine cfg (if (= (xyzt:get "operation" cfg) "4") *xyz:files* (list (xyzt:get "file" cfg))) output))
      (alert (strcat "Archivo generado\n" output "\nPuntos: " (itoa (xyzt:get 'count result)) "\nLos originales se conservaron."))
      (if (= (xyzt:get "import_after" cfg) "1")
        (progn
          (setq *xyzt:ui* (xyzt:put "file" output *xyzt:ui*) *xyzt:ui* (xyzt:put "skip" "0" *xyzt:ui*)
                *xyzt:ui* (xyzt:put "zmode" "0" *xyzt:ui*) *xyzt:ui* (xyzt:put "dz" "0" *xyzt:ui*))
          (foreach item '("sep" "decimal" "cx" "cy" "cz")
            (setq *xyzt:ui* (xyzt:put item (if (= (xyzt:get "operation" cfg) "4")
              (cdr (assoc item '(("sep" . "1") ("decimal" . "0") ("cx" . "1") ("cy" . "2") ("cz" . "3"))))
              (xyzt:get item cfg)) *xyzt:ui*)))
          ;; Procesar conserva encabezados y columnas; repetir skip original.
          (if (/= (xyzt:get "operation" cfg) "4") (setq *xyzt:ui* (xyzt:put "skip" (xyzt:get "skip" cfg) *xyzt:ui*)))
          (setq result T))
        (setq result nil))))) result)

;;; Etiquetas de Z: estilos, ancho, separacion, decimales, absoluto y capa unica.
(setq xyz:label-keys '("labels" "labelheight" "labelwidth" "labelsep" "labeldec" "labelabs" "labelone" "labellayer" "labelstyle" "labelz"))
(defun xyz:labels-dialog (/ code key)
  (if (not (new_dialog "XYZ_LABELS" *xyzt:dclid*)) (xyzt:fail "No se pudo abrir Etiquetas."))
  (foreach key xyz:label-keys (set_tile key (xyzt:get key *xyzt:ui*)))
  (action_tile "accept" "(done_dialog 1)") (action_tile "cancel" "(done_dialog 0)")
  ;; Los valores se capturan antes de cerrar el dialogo.
  (action_tile "accept" "(foreach key xyz:label-keys (setq *xyzt:ui* (xyzt:put key (get_tile key) *xyzt:ui*)))(done_dialog 1)")
  (start_dialog))
(defun xyz:validate-labels (cfg / key value style name)
  (if (= (xyzt:get "labels" cfg) "1")
    (progn
      (foreach key '("labelheight" "labelwidth" "labelsep" "labeldec")
        (setq value (xyzt:setting-number (xyzt:get key cfg)))
        (if (or (null value) (> (abs value) 1e6)) (xyzt:fail (strcat "Etiqueta: numero invalido en " key)))
        (setq cfg (xyzt:put (read (strcat "v-" key)) value cfg)))
      (if (or (<= (xyzt:get 'v-labelheight cfg) 0) (<= (xyzt:get 'v-labelwidth cfg) 0) (< (xyzt:get 'v-labelsep cfg) 0))
        (xyzt:fail "Altura/ancho deben ser positivos y separacion no negativa."))
      (setq value (xyzt:get 'v-labeldec cfg))
      (if (or (/= value (fix value)) (< value 0) (> value 16)) (xyzt:fail "Decimales de etiqueta: entero entre 0 y 16."))
      (setq style (xyzt:trim (xyzt:get "labelstyle" cfg)))
      (if (or (= style "") (not (tblsearch "STYLE" style)))
        (progn (princ "\nEstilo de etiqueta no encontrado; se utilizara Standard.") (setq style "Standard")))
      (setq cfg (xyzt:put "labelstyle" style cfg) name (xyzt:trim (xyzt:get "labellayer" cfg)))
      (if (and (= (xyzt:get "labelone" cfg) "1") (or (= name "") (> (strlen name) 40) (not (snvalid name))))
        (xyzt:fail "Nombre de capa de etiquetas invalido (maximo 40 caracteres).")))) cfg)
(defun xyz:label (p ln lot info cfg / target pos z en)
  (setq target (if (= (xyzt:get "labelone" cfg) "1") *xyz:label-layer* (car info))
        z (if (= (xyzt:get "labelz" cfg) "1") (caddr p) 0.0)
        pos (list (car p) (- (cadr p) (xyzt:get 'v-labelsep cfg)) z))
  (xyzt:make (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 target)
    (cons 420 (xyzt:tc (nth 3 info))) '(100 . "AcDbText")
    (cons 10 pos) (cons 11 pos) '(72 . 1) '(73 . 0)
    (cons 40 (xyzt:get 'v-labelheight cfg)) (cons 41 (xyzt:get 'v-labelwidth cfg))
    (cons 7 (xyzt:get "labelstyle" cfg))
    (cons 1 (rtos (if (= (xyzt:get "labelabs" cfg) "1") (abs (caddr p)) (caddr p)) 2 (fix (xyzt:get 'v-labeldec cfg))))
    (xyzt:tag lot ln))))
(defun c:IXYZ () (setq *xyz:entry* nil) (c:XYZ))
(defun c:PZ () (setq *xyz:entry* "process") (c:XYZ))
(defun c:XYZUNIR () (setq *xyz:entry* "merge") (c:XYZ))

;;; ============================================================================
;;; Integracion de Procesa_Puntos (P-Z): operaciones en dibujo y consulta de Z.
;;; IZ y ZM: POINT; OZ: traslacion WCS nativa de todos los tipos admitidos.
;;; No se cambian escalas, rotaciones, capas ni propiedades por mover entidades.
;;; ============================================================================
(defun xyz:screen-point (point mode distance)
  (list (car point) (cadr point) (if (= mode "IZ") (- (caddr point)) (+ (caddr point) distance))))
(defun xyz:locked (en / ed layer flags)
  (setq ed (entget en) layer (tblsearch "LAYER" (cdr (assoc 8 ed)))
        flags (cdr (assoc 70 layer)))
  (and flags (/= 0 (logand 4 flags))))
(defun xyz:restore-changes (changes / change res failed)
  (setq failed 0)
  (foreach change changes
    (setq res
      (if (= (car change) "MOVE")
        (vl-catch-all-apply 'vla-Move
          (list (vlax-ename->vla-object (cadr change)) (vlax-3d-point '(0.0 0.0 0.0))
            (vlax-3d-point (list 0.0 0.0 (- (caddr change))))))
        (vl-catch-all-apply 'entmod (list (caddr change)))))
    (if (or (vl-catch-all-error-p res) (and (= (car change) "ENTMOD") (not res)))
      (setq failed (1+ failed)))) failed)
(defun xyz:mark-edited-lots (lots mode changes / root lot rec ed updated)
  (setq root (dictsearch (namedobjdict) "IXYZ7_LOTES"))
  (if root
    (foreach lot lots
      (if (setq rec (dictsearch (cdr (assoc -1 root)) lot))
        (progn
          (setq ed (entget (cdr (assoc -1 rec))))
          (setq updated (append ed (list (cons 1 (strcat "EDICION_EN_DIBUJO=" mode "; revisar etiquetas, clases y leyenda")))))
          ;; Se devuelve historial de restauracion, incluida la metainformacion.
          (if (entmod updated)
            (setq changes (cons (list "ENTMOD" (cdr (assoc -1 rec)) ed) changes) *xyz:screen-log* changes)
            (princ (strcat "\nNo se pudo marcar el historial del lote " lot))))))) changes)
(defun xyz:print-z-stats (stat title / n minz maxz text)
  (setq n (car (car stat)))
  (if (= n 0) (princ "\nNo hay puntos validos para analizar.")
    (progn
      (setq minz (cadr stat) maxz (caddr stat))
      (setq text (strcat title "\nPuntos: " (itoa n)
        "\nZ minima: " (xyzt:nstr minz) "\nZ maxima: " (xyzt:nstr maxz)
        "\nDiferencia: " (xyzt:nstr (- maxz minz))
        "\nPunto medio del rango Z: " (xyzt:nstr (/ (+ minz maxz) 2.0))
        "\nPromedio de Z: " (xyzt:nstr (cadr (car stat)))
        "\nDesviacion estandar muestral: " (xyzt:nstr (xyzt:std stat))))
      (princ (strcat "\n" text)) (alert text)))
  stat)
(defun xyz:screen-operation (mode distance / *error* doc mark changes selection i en ed point changed
                              obj processed locked omitted stat lot lots rollback-failed saved-failure)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) mark nil changes nil
        processed 0 locked 0 omitted 0 stat (xyzt:empty-stat) lots nil *xyzt:failure* nil *xyz:screen-log* nil)
  (defun *error* (msg)
    (setq msg (if *xyzt:failure* *xyzt:failure* msg) *xyzt:failure* nil)
    (setq rollback-failed (xyz:restore-changes *xyz:screen-log*))
    (if mark (vl-catch-all-apply 'vla-EndUndoMark (list doc)))
    ;; Cuando se invoca desde el panel XYZ tambien se libera su interfaz temporal.
    (if (and *xyzt:dclid* (numberp savedcm) (numberp saveddz) (numberp savedpd))
      (progn (xyzt:cleanup) (setvar "CMDECHO" savedcm) (setvar "DIMZIN" saveddz) (setvar "PDSIZE" savedpd)))
    (princ (strcat "\n" mode " detenido: " (if msg msg "sin mensaje")))
    (if (> rollback-failed 0)
      (princ (strcat "\nNo se pudieron restaurar " (itoa rollback-failed) " cambios; revise el dibujo y use U."))
      (if changes (princ "\nSe restauraron los objetos modificados durante esta operacion.")))
    (setq *xyz:screen-log* nil)
    (princ))
  (if (and (= mode "OZ") (not (numberp distance))) (xyzt:fail "El desplazamiento Z debe ser numerico."))
  (if (and (= mode "OZ") (= distance 0.0)) (princ "\nDesplazamiento cero: sin cambios.")
    (progn
      (princ (if (= mode "OZ") "\nSeleccione objetos a desplazar en Z mundial: " "\nSeleccione puntos POINT: "))
      (setq selection (ssget
        (if (= mode "OZ")
          '((0 . "POINT,3DFACE,*POLYLINE,LINE,SPLINE,INSERT,REGION,SOLID,3DSOLID,MESH,TEXT,MTEXT,CIRCLE,ARC,ELLIPSE"))
          '((0 . "POINT")))))
      (if selection
        (progn
          (if (/= mode "ZM")
            (progn
              (if (= 0 (logand 1 (getvar "UNDOCTL"))) (xyzt:fail "Active DESHACER antes de modificar objetos."))
              (vla-StartUndoMark doc) (setq mark T)))
          (setq i 0)
          (repeat (sslength selection)
            (setq en (ssname selection (float i)) ed (entget en))
            (cond
              ((= mode "ZM")
                (setq point (cdr (assoc 10 ed)))
                (if (and point (= (length point) 3))
                  (setq stat (xyzt:stat-add stat point) processed (1+ processed))
                  (setq omitted (1+ omitted))))
              ((xyz:locked en) (setq locked (1+ locked)))
              ((= mode "IZ")
                (setq point (cdr (assoc 10 ed)))
                (if (and point (= (length point) 3))
                  (progn
                    (setq changed (subst (cons 10 (xyz:screen-point point "IZ" 0.0)) (assoc 10 ed) ed))
                    (if (not (entmod changed)) (xyzt:fail "No se pudo cambiar un punto. Se restaura la seleccion."))
                    (setq changes (cons (list "ENTMOD" en ed) changes) *xyz:screen-log* changes processed (1+ processed)))
                  (setq omitted (1+ omitted))))
              (T
                ;; vla-Move expresa el vector en WCS y respeta OCS de bloques/polilineas.
                (setq obj (vlax-ename->vla-object en))
                (vla-Move obj (vlax-3d-point '(0.0 0.0 0.0)) (vlax-3d-point (list 0.0 0.0 distance)))
                (setq changes (cons (list "MOVE" en distance) changes) *xyz:screen-log* changes processed (1+ processed))))
            (if (and (/= mode "ZM") (not (xyz:locked en)) (setq lot (xyzt:lot-of en)) (not (member lot lots)))
              (setq lots (cons lot lots)))
            (setq i (1+ i)))
          (if (= mode "ZM") (xyz:print-z-stats stat "Z Min / Max - puntos del dibujo")
            (progn
              (setq changes (xyz:mark-edited-lots lots mode changes))
              (vla-EndUndoMark doc) (setq mark nil changes nil *xyz:screen-log* nil)
              (vl-catch-all-apply 'vla-Regen (list doc 1))
              (princ (strcat "\n" mode ": " (itoa processed) " objetos modificados; " (itoa locked)
                " en capas bloqueadas; " (itoa omitted) " omitidos."))
              (if lots
                (princ "\nLotes marcados como editados: sus etiquetas, clases y leyendas requieren revision.")))))
        (princ "\nNo se seleccionaron objetos compatibles."))))
  (princ))
(defun xyz:file-z-stats (cfg / stats)
  (setq stats (xyzt:analyze (xyz:identity-config cfg) nil (xyzt:detect cfg)))
  (xyz:print-z-stats (xyzt:get 'raw stats) (strcat "Z Min / Max - archivo\n" (xyzt:get "file" cfg)))
  (princ (strcat "\nFilas no validas: " (itoa (xyzt:get 'invalid stats))
                 " | Encabezados/comentarios/omitidas: " (itoa (xyzt:get 'skip stats))))
  stats)

;;; Panel compatible con P-Z original: Fuente Pantalla/Archivo y Operacion.
(setq xyz:point-keys '("pt_operation" "pt_source" "pt_offset" "pt_file" "pt_format"))
(defun xyz:point-save (/ key)
  (foreach key xyz:point-keys (setq *xyz:point-ui* (xyzt:put key (get_tile key) *xyz:point-ui*))))
(defun xyz:point-exit (code) (xyz:point-save) (done_dialog code))
(defun xyz:point-dialog (/ key)
  (if (not (new_dialog "XYZ_POINTTOOLS" *xyzt:dclid*)) (xyzt:fail "No se pudo abrir el panel P-Z."))
  (xyzt:fill-popup "pt_operation" '("Invertir Z (IZ)" "Offset Z (OZ)" "Z minima / maxima (ZM)" "Unir archivos XYZ"))
  (xyzt:fill-popup "pt_source" '("En pantalla" "Archivo XYZ / TXT / CSV"))
  (xyzt:fill-popup "pt_format" '("Columnas X Y Z" "Columnas N / ID, X, Y, Z"))
  (foreach key xyz:point-keys (set_tile key (xyzt:get key *xyz:point-ui*)))
  (action_tile "pick_file" "(xyz:point-exit 2)")
  (action_tile "accept" "(xyz:point-exit 1)")
  (action_tile "cancel" "(xyz:point-exit 0)")
  (action_tile "pt_source" "(xyz:point-ui-state)")
  (action_tile "pt_operation" "(xyz:point-ui-state)")
  (xyz:point-ui-state)
  (start_dialog))
(defun xyz:pointtools-flow (/ code path mode source distance result cfg item)
  (if (not *xyz:point-ui*)
    (setq *xyz:point-ui* (list '("pt_operation" . "0") '("pt_source" . "0") '("pt_offset" . "0")
      (cons "pt_file" (xyzt:get "file" *xyzt:ui*)) '("pt_format" . "0"))))
  (setq code -1 result nil)
  (while (and (/= code 0) (/= code 1))
    (setq code (xyz:point-dialog))
    (if (= code 2)
      (progn
        (setq path (getfiled "Archivo de puntos" (xyzt:get "pt_file" *xyz:point-ui*) "xyz;txt;csv;asc" 0))
        (if path (setq *xyz:point-ui* (xyzt:put "pt_file" path *xyz:point-ui*))))))
  (if (= code 1)
    (progn
      (setq mode (atoi (xyzt:get "pt_operation" *xyz:point-ui*))
            source (xyzt:get "pt_source" *xyz:point-ui*)
            distance (xyzt:setting-number (xyzt:get "pt_offset" *xyz:point-ui*)))
      (if (and (= mode 1) (null distance)) (xyzt:fail "Ingrese un offset Z numerico."))
      (cond
        ((= mode 3)
          (if (= source "0") (xyz:export-screen)
            (setq result (xyz:process-flow T))))
        ((= source "0") (xyz:screen-operation (nth mode '("IZ" "OZ" "ZM")) distance))
        (T
          (setq path (xyzt:get "pt_file" *xyz:point-ui*))
          (if (= path "") (xyzt:fail "Seleccione un archivo de puntos."))
          (setq *xyzt:ui* (xyzt:put "file" path *xyzt:ui*))
          (if (not *xyz:last-process*) (setq *xyz:last-process* (xyz:process-defaults path)))
          (setq *xyz:last-process* (xyzt:put "file" path *xyz:last-process*)
                *xyz:last-process* (xyzt:put "operation" (nth mode '("0" "1" "5")) *xyz:last-process*)
                *xyz:last-process* (xyzt:put "amount" (xyzt:get "pt_offset" *xyz:point-ui*) *xyz:last-process*)
                *xyz:last-process* (xyzt:put "import_after" (if (= mode 2) "0" "1") *xyz:last-process*))
          (setq *xyz:last-process* (xyzt:put "cx" (if (= (xyzt:get "pt_format" *xyz:point-ui*) "1") "2" "1") *xyz:last-process*)
                *xyz:last-process* (xyzt:put "cy" (if (= (xyzt:get "pt_format" *xyz:point-ui*) "1") "3" "2") *xyz:last-process*)
                *xyz:last-process* (xyzt:put "cz" (if (= (xyzt:get "pt_format" *xyz:point-ui*) "1") "4" "3") *xyz:last-process*))
          (setq result (xyz:process-flow nil)))))) result)
(defun c:P-Z () (setq *xyz:entry* "pointtools") (c:XYZ))
(defun c:IZ () (xyz:screen-operation "IZ" 0.0))
(defun c:OZ (/ distance)
  (setq distance (getreal "\nDesplazamiento en Z mundial, positivo o negativo <0>: "))
  (if (null distance) (setq distance 0.0))
  (xyz:screen-operation "OZ" distance))
(defun c:ZM () (xyz:screen-operation "ZM" 0.0))
(defun c:XYZU () (c:XYZUNIR))

;;; Exportacion de POINT seleccionados a archivo XYZ, sin alterar el dibujo.
(defun xyz:export-screen (/ selection path output temp report reporttemp i en ed point count stat source)
  (princ "\nSeleccione puntos POINT a exportar (ventana o seleccion directa): ")
  (setq selection (ssget '((0 . "POINT"))))
  (if selection
    (progn
      (setq path (getfiled "Exportar puntos seleccionados a XYZ" (strcat (getvar "DWGPREFIX") "PUNTOS_EXPORTADOS.xyz") "xyz" 33))
      (if path
        (progn
          (setq output (xyz:unique-path path)
                temp (vl-filename-mktemp "xyzt_export_" (vl-filename-directory output) ".tmp")
                report (xyz:unique-path (strcat (vl-filename-directory output) "\\" (vl-filename-base output) "_CONTROL.csv"))
                reporttemp (vl-filename-mktemp "xyzt_control_" (vl-filename-directory output) ".tmp")
                *xyz:workfiles* (list temp reporttemp)
                *xyzt:out* (open temp "w") *xyzt:log* (open reporttemp "w")
                count 0 i 0 stat (xyzt:empty-stat)
                source (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
          (if (or (not *xyzt:out*) (not *xyzt:log*)) (xyzt:fail "No se puede escribir en la carpeta de exportacion."))
          (write-line "Seccion;Archivo;Linea;Motivo;Valor" *xyzt:log*)
          (xyz:control "METADATO" source 0 "OPERACION" "EXPORTAR POINT EN WCS; SIN MODIFICAR EL DIBUJO")
          (repeat (sslength selection)
            (setq en (ssname selection (float i)) ed (entget en) point (cdr (assoc 10 ed)))
            (if (and (= (cdr (assoc 0 ed)) "POINT") (= (length point) 3)
                     (numberp (car point)) (numberp (cadr point)) (numberp (caddr point)))
              (progn
                (write-line (xyz:join (mapcar '(lambda (v) (xyz:number-text v -1 ".")) point) " ") *xyzt:out*)
                (setq count (1+ count) stat (xyzt:stat-add stat point))))
            (setq i (1+ i))
            (if (= 0 (rem i 10000)) (princ (strcat "\rExportados: " (itoa count)))))
          (if (= count 0) (xyzt:fail "No se encontraron puntos validos para exportar."))
          (xyz:control "RESUMEN" source 0 "PUNTOS_EXPORTADOS" (itoa count))
          (xyz:control "RESUMEN" source 0 "XYZ_MIN" (xyzt:serialize (nth 3 stat)))
          (xyz:control "RESUMEN" source 0 "XYZ_MAX" (xyzt:serialize (nth 4 stat)))
          (close *xyzt:out*) (setq *xyzt:out* nil) (close *xyzt:log*) (setq *xyzt:log* nil)
          (if (not (vl-file-rename reporttemp report)) (xyzt:fail "No se pudo publicar el control de exportacion."))
          (setq *xyz:workfiles* (cons report *xyz:workfiles*))
          (if (not (vl-file-rename temp output)) (xyzt:fail "No se pudo publicar XYZ. No se sobrescribieron archivos."))
          (setq *xyz:workfiles* nil)
          (alert (strcat "Exportacion terminada\nPuntos: " (itoa count) "\n" output "\nEl dibujo se conservo."))))))
  (princ))
(defun xyz:point-ui-state (/ source mode current)
  (setq source (get_tile "pt_source") mode (get_tile "pt_operation") current mode)
  (xyzt:fill-popup "pt_operation"
    (if (= source "0")
      '("Invertir Z (IZ)" "Offset Z (OZ)" "Z minima / maxima (ZM)" "Exportar puntos del dibujo")
      '("Invertir Z (IZ)" "Offset Z (OZ)" "Z minima / maxima (ZM)" "Unir archivos XYZ")))
  (set_tile "pt_operation" current)
  (mode_tile "pt_offset" (if (= mode "1") 0 1))
  (mode_tile "pt_file" (if (and (= source "1") (/= mode "3")) 0 1))
  (mode_tile "pick_file" (if (and (= source "1") (/= mode "3")) 0 1))
  (mode_tile "pt_format" (if (and (= source "1") (/= mode "3")) 0 1)))
(defun c:EXYZ () (setq *xyz:entry* "export") (c:XYZ))
(defun c:XYZEXPORTAR () (c:EXYZ))

;;; Pruebas integradas SIN modificar el dibujo. Ejecute XYZTEST.
(defun xyzt:test-check (label actual expected tol)
  (if (if tol (equal actual expected tol) (equal actual expected))
    (progn (setq *xyzt:test-ok* (1+ *xyzt:test-ok*)) (princ (strcat "\n  OK " label)))
    (progn (setq *xyzt:test-bad* (1+ *xyzt:test-bad*))
      (princ (strcat "\n  FALLO " label " obtenido=" (vl-prin1-to-string actual)
        " esperado=" (vl-prin1-to-string expected))))))
(defun c:XYZTEST (/ cfg classes stat poly z)
  (setq *xyzt:test-ok* 0 *xyzt:test-bad* 0)
  (xyzt:test-check "Ajuste cero numerico" (xyzt:setting-number "0") 0.0 1e-10)
  (xyzt:test-check "Ajuste con punto" (xyzt:setting-number "0.5") 0.5 1e-10)
  (xyzt:test-check "Ajuste con coma" (xyzt:setting-number "0,5") 0.5 1e-10)
  (xyzt:test-check "Ajuste negativo" (xyzt:setting-number "-8,5") -8.5 1e-10)
  (xyzt:test-check "Ajuste invalido" (xyzt:setting-number "abc") nil nil)
  (xyzt:test-check "Decimal punto" (xyzt:number "-12.500" ".") -12.5 1e-10)
  (xyzt:test-check "Decimal coma" (xyzt:number "-12,500" ",") -12.5 1e-10)
  (xyzt:test-check "Z cero" (xyzt:number "0" ".") 0.0 1e-10)
  (xyzt:test-check "Cientifico" (xyzt:number "1.25E+3" ".") 1250.0 1e-8)
  (xyzt:test-check "Signo mas" (xyzt:number "+.5" ".") 0.5 1e-10)
  (xyzt:test-check "Rechaza unidades" (xyzt:number "12m" ".") nil nil)
  (xyzt:test-check "Rechaza miles ambiguos" (xyzt:number "1,234.5" ".") nil nil)
  (xyzt:test-check "Rechaza vacio" (xyzt:number "" ".") nil nil)
  (xyzt:test-check "Rechaza exponente incompleto" (xyzt:number "1e-" ".") nil nil)
  (xyzt:test-check "WS mezclado" (xyzt:fields (strcat "1" (chr 9) "2  3") "WS") '("1" "2" "3") nil)
  (xyzt:test-check "CSV comillas" (xyzt:fields "1;\"a;b\";3" ";") '("1" "a;b" "3") nil)
  (xyzt:test-check "CSV campo vacio" (xyzt:fields "1;;3" ";") '("1" "" "3") nil)
  (xyzt:test-check "CSV comilla escapada" (xyzt:fields "1;\"a\"\"b\";3" ";") '("1" "a\"b" "3") nil)
  (xyzt:test-check "CSV comilla abierta" (xyzt:fields "1;\"2;3" ";") nil nil)
  (xyzt:test-check "Porcentaje 25" (xyzt:percent 250 1000) 25.0 1e-10)
  (xyzt:test-check "Porcentaje sin puntos" (xyzt:percent 0 0) 0.0 1e-10)
  (xyzt:test-check "Color hexadecimal" (xyzt:hex '(255 0 16)) "#FF0010" nil)
  (xyzt:test-check "Floor negativo" (xyzt:floor -0.1) -1 nil)
  (setq cfg (xyzt:defaults) cfg (xyzt:put 'xyfactor 1.0 cfg)
        cfg (xyzt:put 'zfactor -1.0 cfg) cfg (xyzt:put 'offset 2.0 cfg))
  (xyzt:test-check "Profundidad y nivel agua" (xyzt:line "574823.751 2110342.154 8.5" cfg "WS")
    '(574823.751 2110342.154 -6.5) 1e-8)
  (setq cfg (xyzt:put 'zfactor 1.0 cfg) cfg (xyzt:put 'offset 0.0 cfg))
  (xyzt:test-check "Cota negativa conservada" (caddr (xyzt:line "1 2 -8.5" cfg "WS")) -8.5 1e-10)
  (xyzt:test-check "Rechaza XY invalidos" (xyzt:line "error 2 3" cfg "WS") nil nil)
  (setq cfg (xyzt:put "cx" "2" cfg) cfg (xyzt:put "cy" "3" cfg) cfg (xyzt:put "cz" "4" cfg))
  (xyzt:test-check "ID XYZ" (xyzt:line "P01 1 2 3" cfg "WS") '(1.0 2.0 3.0) 1e-10)
  (setq classes '(("A" -2.0 -1.0 (0 0 0)) ("B" -1.0 0.0 (255 0 0))))
  (xyzt:test-check "Clase limite inferior" (xyzt:class-index -2.0 classes "0") 0 nil)
  (xyzt:test-check "Clase frontera interior" (xyzt:class-index -1.0 classes "0") 1 nil)
  (xyzt:test-check "Clase maximo incluido" (xyzt:class-index 0.0 classes "0") 1 nil)
  (xyzt:test-check "Fuera no satura" (xyzt:class-index 1.0 classes "0") nil nil)
  (xyzt:test-check "Saturacion explicita" (xyzt:class-index 1.0 classes "1") 1 nil)
  (setq poly '((0.0 0.0) (10.0 0.0) (10.0 10.0) (0.0 10.0)))
  (xyzt:test-check "Interior poligono" (xyzt:inside '(5 5 0) poly) T nil)
  (xyzt:test-check "Borde poligono" (xyzt:inside '(0 5 0) poly) T nil)
  (xyzt:test-check "Exterior poligono" (xyzt:inside '(11 5 0) poly) nil nil)
  (setq stat (xyzt:empty-stat))
  (foreach z '(1.0 2.0 3.0) (setq stat (xyzt:stat-add stat (list 0.0 0.0 z))))
  (xyzt:test-check "Media Welford" (cadr (car stat)) 2.0 1e-10)
  (xyzt:test-check "Desviacion Welford" (xyzt:std stat) 1.0 1e-10)
  (xyzt:test-check "Celda somero" (xyzt:grid-better '((0 0 -2) 2) '((0 0 -5) 1) 3) T nil)
  (xyzt:test-check "Celda profundo" (xyzt:grid-better '((0 0 -5) 2) '((0 0 -2) 1) 4) T nil)
  (xyzt:test-check "Celda conserva primero" (xyzt:grid-better '((0 0 -5) 2) '((0 0 -2) 1) 2) nil nil)
  (xyzt:test-check "Proceso invertir" (xyz:transform 8.5 0 0 nil 0 0) -8.5 1e-10)
  (xyzt:test-check "Proceso invertir cero" (xyz:transform 0.0 0 0 nil 0 0) 0.0 1e-10)
  (xyzt:test-check "Proceso offset" (xyz:transform -8.5 1 0.5 nil 0 0) -8.0 1e-10)
  (xyzt:test-check "Rango interior" (xyz:transform -5 2 0 '((-10 0 1) (0 10 2)) 0 0) -4 1e-10)
  (xyzt:test-check "Rango frontera unica" (xyz:transform 0 2 0 '((-10 0 1) (0 10 2)) 0 0) 2 1e-10)
  (xyzt:test-check "Rango exterior" (xyz:transform 11 2 0 '((-10 0 1) (0 10 2)) 0 0) 11 1e-10)
  (xyzt:test-check "Rango ultimo maximo" (xyz:transform 10 2 0 '((-10 0 1) (0 10 2)) 0 0) 12 1e-10)
  (xyzt:test-check "Eliminar Z cero" (xyz:transform 0 3 0 nil 0 0) nil nil)
  (xyzt:test-check "Conservar Z fuera" (xyz:transform -1 3 0 nil 0 0) -1 1e-10)
  (xyzt:test-check "Reemplazo solo columna Z" (xyz:replace-index '("P1" "100" "200" "-8.5" "arena") 3 "8.5")
    '("P1" "100" "200" "8.5" "arena") nil)
  (xyzt:test-check "Union de campos extra" (xyz:join '("P1" "100" "200" "8.5" "arena") ";") "P1;100;200;8.5;arena" nil)
  (xyzt:test-check "Rangos sin acumulacion" (xyz:transform -10 2 0 '((-10 0 1) (0 10 2)) 0 0) -9 1e-10)
  (xyzt:test-check "Etiqueta intervalo normal" (xyzt:class-label '("CLASE" -25.0 -24.5 (0 0 0))) "-25.00 a -24.50" nil)
  (xyzt:test-check "LAST de clases devuelve clase" (last '(("A" 1) ("B" 2))) '("B" 2) nil)
  (xyzt:test-check "LAST de poligono devuelve vertice" (last '((0 0) (1 0) (1 1))) '(1 1) nil)
  (princ (strcat "\nXYZTEST: " (itoa *xyzt:test-ok*) " correctas; " (itoa *xyzt:test-bad*)
    " fallidas. No verifica DCL, ActiveX, archivos ni entidades CAD.")) (princ))
(princ (strcat "\nXYZ-Tools " *xyzt:version* " cargado. Comandos XYZ / IXYZ / PZ / P-Z / IZ / OZ / ZM / XYZU | Ayuda XYZAYUDA | Pruebas XYZTEST"))
(princ)
