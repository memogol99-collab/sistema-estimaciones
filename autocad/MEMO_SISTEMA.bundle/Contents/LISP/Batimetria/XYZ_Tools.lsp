  (action_tile "replace_button" "(xyzt:ui-exit 6)")
  (action_tile "help" "(xyzt:ui-exit 7)")
  (action_tile "out_button" "(xyzt:ui-exit 8)")
  (action_tile "clear_poly" "(setq *xyzt:polygon* nil)(set_tile \"polygon_status\" \"Poligono: ninguno\")")
  (action_tile "clear_replace" "(setq *xyzt:replace* nil)(set_tile \"replace_status\" \"Modo: agregar lote nuevo\")")
  (action_tile "process_button" "(xyzt:ui-exit 9)")
  (action_tile "merge_button" "(xyzt:ui-exit 10)")
  (action_tile "labels_button" "(xyzt:ui-exit 11)")
  (action_tile "pointtools_button" "(xyzt:ui-exit 12)")
  (action_tile "export_button" "(xyzt:ui-exit 13)")
  (action_tile "accept" "(xyzt:ui-exit 1)")
  (action_tile "cancel" "(xyzt:ui-exit 0)")
