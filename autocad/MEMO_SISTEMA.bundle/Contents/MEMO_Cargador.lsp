;;; =====================================================================
;;;  MEMO_Cargador.lsp  -  MEMO SISTEMA 2.0.0
;;;  ARCHIVO GENERADO: no editar a mano; edite herramientas/catalogo.py
;;;
;;;  Un solo cargador para todos los LISP. NO carga los 54 archivos al
;;;  abrir cada dibujo: define cada comando como "stub" y el archivo
;;;  real se carga la primera vez que se usa el comando (carga bajo
;;;  demanda). Arranque mas rapido y sin choques entre archivos.
;;; =====================================================================
(vl-load-com)

(if (not memo:cargado)
  (progn
    (setq memo:version "2.0.0")
    (setq memo:raiz (findfile "MEMO_Cargador.lsp"))
    (if memo:raiz
      (setq memo:raiz (vl-string-translate "\\" "/" (vl-filename-directory memo:raiz))))
    (setq memo:archivos-cargados nil memo:num-comandos 0)

    ;; Carga el archivo real y ejecuta el comando solicitado
    (defun memo:cargar (rel cmd / ruta res)
      (setq ruta (strcat memo:raiz "/LISP/" rel))
      (cond
        ((member rel memo:archivos-cargados)
         (princ (strcat "\nMEMO: " rel " se cargo pero no define el comando " cmd)))
        ((not (or (findfile (strcat ruta ".lsp")) (findfile (strcat ruta ".fas")) (findfile (strcat ruta ".vlx"))))
         (princ (strcat "\nMEMO: no se encuentra " ruta ".lsp")))
        (T
         (setq memo:archivos-cargados (cons rel memo:archivos-cargados))
         (setq res (vl-catch-all-apply 'load (list ruta)))
         (if (vl-catch-all-error-p res)
           (princ (strcat "\nMEMO: error al cargar " rel ": " (vl-catch-all-error-message res)))
           (eval (list (read (strcat "C:" cmd)))))))
      (princ))

    ;; Define un comando que carga su archivo al primer uso
    (defun memo:al (rel cmds)
      (foreach cmd cmds
        (if (not (eval (read (strcat "C:" cmd))))
          (progn
            (eval (list 'defun (read (strcat "C:" cmd)) nil (list 'memo:cargar rel cmd)))
            (setq memo:num-comandos (1+ memo:num-comandos))))))

    (if memo:raiz
      (progn
        (memo:al "Estimaciones/COP_ConceptosObrasPublicas" '("COP" "LIMPIARTABLA"))
        (memo:al "Estimaciones/ASI_ConceptosAsipona" '("ASI"))
        (memo:al "Estimaciones/CSSA_ConceptosSSA" '("LIMPIARCSSA" "CSSA"))
        (memo:al "Estimaciones/LC_LimpiarConceptos" '("LC"))
        (memo:al "Estimaciones/CAS_CompAreaSecc" '("CAS" "QA"))
        (memo:al "Estimaciones/IJPG_CadAJpg" '("IJPG" "IJPG-EMF" "IJPG-PC3"))
        (memo:al "Bacheo/RS_RectanguloSnap" '("RS" "CC" "AEC" "RC2" "RSHATCH" "RS-CONFIG"))
        (memo:al "Bacheo/RV_RenumerarRectangulos" '("RENUMERARVECINO" "RV"))
        (memo:al "Bacheo/COTB_CotarBaches" '("COTB"))
        (memo:al "Bacheo/EXR_ExportaRectangulos" '("EXR" "VERLISTA" "VERXDATA" "AXD"))
        (memo:al "Bacheo/HR_HatchRectangulos" '("HR"))
        (memo:al "Bacheo/BTR_BorrarTextoEnRect" '("BTR"))
        (memo:al "Secciones/EL_Elevacion" '("EL"))
        (memo:al "Secciones/R00_CambiaNumeros" '("R00"))
        (memo:al "Secciones/AM2_AreaM2" '("AM2"))
        (memo:al "Secciones/HA_AreaPrefijo" '("HA2" "HA" "HAPREF" "HARESET" "HAINFO"))
        (memo:al "Secciones/AS_AreaSecc3P" '("AS"))
        (memo:al "Secciones/AC_AreaContorno" '("AC"))
        (memo:al "Secciones/AH_AreaHatch" '("AH2" "AH" "AHINFO"))
        (memo:al "Secciones/EA_ExportarEstArea" '("EA" "HAEA-EXPORT" "EA-HA" "HAEA"))
        (memo:al "Textos/CT_Toolbox" '("CT" "CTE" "CTP" "IPT" "CTN" "STV"))
        (memo:al "Textos/CTT_CambiaTexto" '("CTT"))
        (memo:al "Textos/ALIT_AlinearTexto" '("ALIT"))
        (memo:al "Textos/PTE_Pendiente" '("PTE"))
        (memo:al "Textos/UL_MayMin" '("UL"))
        (memo:al "Textos/PS_PrefijoSufijo" '("PS" "PREFSUFIND" "VERPREFSUF" "LIMPIARPREFSUF" "SETPREFSUF"))
        (memo:al "Textos/RTT_RotarTexto" '("RTT"))
        (memo:al "Textos/ST_SumaTextos" '("ST" "ST-TEST"))
        (memo:al "Textos/CTAF_TextoAltoAncho" '("CTAF" "CTF" "CTAF2"))
        (memo:al "Textos/CORM_CoordenadasATexto" '("COR" "COR2" "CORM"))
        (memo:al "Hatch/SPH_SeparaFusionaHatch" '("SEPARAHATCH" "SPH" "FUSIONHATCH" "FH"))
        (memo:al "Hatch/CHS_HatchSimilar" '("CHS"))
        (memo:al "VistasLayout/CV_CrearVistas" '("CV"))
        (memo:al "VistasLayout/AV_GuardarRestaurarVistas" '("AV" "GV"))
        (memo:al "VistasLayout/BV_BorrarVistas" '("BV"))
        (memo:al "VistasLayout/CL_ClonarLayout" '("CL"))
        (memo:al "VistasLayout/CFTL_ConfigurarLayouts" '("CFTL"))
        (memo:al "VistasLayout/SL_SuprimirLayouts" '("SL"))
        (memo:al "Topografia/ICE_ImportarPuntos" '("ICE"))
        (memo:al "Topografia/PCC_PuntosCivilACapas" '("PCC"))
        (memo:al "Topografia/UPP_UnirPuntosPol" '("UPP" "UPPA"))
        (memo:al "Topografia/MP_MallaPuntos" '("MALLA-PUNTOS" "EXPORTAR-PUNTOS" "MP" "MLL" "EXP"))
        (memo:al "Topografia/XY_ExportarCoordPol" '("X-Y"))
        (memo:al "Topografia/CPEC_ColorearPorElevacion" '("CPEC"))
        (memo:al "Topografia/CCN_CurvasNivel" '("CCN" "CCNT" "CCNAYUDA" "CCNTEST"))
        (memo:al "Topografia/ECN_ElevacionCurvas" '("ECN-DUPLICADOS" "ECN-P" "ECN-M" "ECN-ETIQ" "ECN-ETIQM" "ECN-QUITAR" "ECN-RECOLOR" "ECN-LIMPIA" "ECN-DESHACER" "ECN-LISTA" "ECN-CONFIG" "ETM" "ECN"))
        (memo:al "Topografia/BPOL_BorraPol" '("BPOL"))
        (memo:al "Topografia/CLIPIT" '("CLIPIT"))
        (memo:al "Batimetria/XYZ_Tools" '("XYZRESTAURAR" "XYZAYUDA" "XYZLOTES" "XYZBORRAR" "XYZ" "IXYZ" "PZ" "XYZUNIR" "P-Z" "IZ" "OZ" "ZM" "XYZU" "EXYZ" "XYZEXPORTAR" "XYZTEST"))
        (memo:al "Batimetria/PIT_PuntoInsTexto" '("PIT"))
        (memo:al "Batimetria/PERFIL_Transversal" '("PERFIL"))
        (memo:al "Bloques/IBC_BloquesEnCapa" '("IBC"))
        (memo:al "Bloques/IBCZ_BloquesEnCapaEscala" '("IBCZ" "ARBOLES" "RAP" "DES" "PV" "TM" "CFE" "VERBLOQUES" "VERCAPAS" "CONFIGESCALAS"))
        (memo:al "Bloques/IBM_BloquesMultiples" '("IBM"))
        (setq memo:cargado T)
        (princ (strcat "\nMEMO SISTEMA " memo:version " listo: " (itoa memo:num-comandos)
                       " comandos. Escriba MEMO_AYUDA para ver la lista.")))
      (princ "\nMEMO: no se encontro MEMO_Cargador.lsp en las rutas de soporte."))))

