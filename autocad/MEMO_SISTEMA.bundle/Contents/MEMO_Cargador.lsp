(defun c:MEMO_INFO ()
  (princ (strcat "\nMEMO SISTEMA " memo:version))
  (princ (strcat "\nCarpeta: " (if memo:raiz memo:raiz "(no encontrada)")))
  (princ (strcat "\nComandos registrados: " (itoa memo:num-comandos)))
  (princ "\nArchivos ya cargados en este dibujo:")
  (if memo:archivos-cargados
    (foreach a (reverse memo:archivos-cargados) (princ (strcat "\n  " a)))
    (princ "\n  (ninguno todavia: se cargan al usar cada comando)"))
  (princ (strcat "\nMenu " "MEMO_SISTEMA" ": " (if (menugroup "MEMO_SISTEMA") "cargado" "NO cargado")))
  (princ))

(defun c:MEMO_QUITAR_ANTERIOR (/ old)
  ;; Descarga el menu viejo 'MEMO' (Memo.cuix con rutas fijas a AutoCAD 2024/2026)
  (if (menugroup "MEMO")
    (progn
      (setq old (getvar "CMDECHO"))
      (setvar "CMDECHO" 0)
      (command "_.CUIUNLOAD" "MEMO")
      (setvar "CMDECHO" old)
      (princ "\nMenu anterior MEMO descargado. Sus LISP ya no se cargaran al abrir dibujos."))
    (princ "\nEl menu anterior MEMO no esta cargado. Nada que hacer."))
  (princ))

(princ)
