  (princ "\n   COP              Tabla de conceptos de 5 columnas (No. | Código | Concepto | Unidad | Precio). Lee lo copiado en Excel (portapapeles).")
  (princ "\n   ASI              Tabla de conceptos de 7 columnas (No. | Código | Descripción | Unidad | P.U. | Cantidad | Importe) con total. Lee el portapapeles.")
  (princ "\n   CSSA             Tabla de conceptos formato SSA (No. | Concepto | Unidad | Cantidad) con recuadros. Lee el portapapeles.")
  (princ "\n   LCO              Borra TEXT y MTEXT de la capa CONCEPTOS.")
  (princ "\n   LIMPIARTABLA     Borra textos de las capas CONCEPTOS y ENCABEZADOS (tablas COP/ASI).")
  (princ "\n   LIMPIARCSSA      Borra los elementos creados por CSSA.")
