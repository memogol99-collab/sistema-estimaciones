  (princ "\n   RV    -> RNB                    (tu alias REVOLUCION)")
  (princ "\n   CC    -> RSC                    (tu alias CERRARCINTA)")
  (princ "\n   PV    -> IBPV                   (tu alias PTOVISTA)")
  (princ "\n   TM    -> IBTM                   (tu alias TILEMODE)")
  (princ "\n   CL    -> CLO                    (tu alias LINEACENTRO)")
  (princ "\n   LC    -> LCO                    (tu alias LINEACENTRO)")
  (princ "\n   CT    -> CTB                    (tu alias TXTC / CTABLESTYLE)")
  (princ "\n   CTT   -> CTX                    (tu alias ADMATRB)")
