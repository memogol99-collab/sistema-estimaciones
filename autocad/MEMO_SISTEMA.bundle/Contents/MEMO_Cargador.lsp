;;; =====================================================================
;;;  MEMO_Cargador.lsp  -  MEMO SISTEMA 2.1.1
;;;  ARCHIVO GENERADO: no editar a mano; edite herramientas/catalogo.py
;;;
;;;  Un solo cargador para todos los LISP. NO carga los 55 archivos al
;;;  abrir cada dibujo: define cada comando como "stub" y el archivo real
;;;  se carga la primera vez que se usa el comando (carga bajo demanda).
;;;  Si existen versiones compiladas (MEMO_COMPILAR) de esta misma versión,
;;;  carga los .fas en lugar de los .lsp.
;;; =====================================================================
(vl-load-com)

(if (not memo:cargado)
  (progn
    (setq memo:version "2.1.1")
    (setq memo:raiz (findfile "MEMO_Cargador.lsp"))
    (if memo:raiz
      (setq memo:raiz (vl-string-translate "\\" "/" (vl-filename-directory memo:raiz))))
    (setq memo:archivos-cargados nil memo:num-comandos 0 memo:*mapa* nil memo:*stubs* nil memo:*ya-definidos* nil)
    (setq memo:dir-fas (strcat (vl-string-translate "\\" "/" (getenv "APPDATA")) "/MEMO_SISTEMA/FAS/"))

    ;; Valores configurables: (CLAVE "defecto" "descripción" "NUM|TXT" "opciones")
    (setq memo:*cfg-def* '(
      ("TABLA_PORTAPAPELES" "PREGUNTAR" "Tablas: usar portapapeles (SI/NO/PREGUNTAR)" "TXT" "SI,NO,PREGUNTAR")
      ("COP_ANCHO_NO" "0.5" "COP: ancho columna No." "NUM" "")
      ("COP_ANCHO_CODIGO" "4.6641" "COP: ancho No.+Código" "NUM" "")
      ("COP_ANCHO_CONCEPTO" "21.1083" "COP: ancho Concepto" "NUM" "")
      ("COP_ANCHO_UNIDAD" "2.0596" "COP: ancho Unidad" "NUM" "")
      ("COP_ANCHO_PRECIO" "2.0596" "COP: ancho Precio" "NUM" "")
      ("ASI_ANCHO_NO" "0.9841" "ASI: ancho No." "NUM" "")
      ("ASI_ANCHO_CODIGO" "1.7887" "ASI: ancho Código" "NUM" "")
      ("ASI_ANCHO_DESCRIPCION" "14.8620" "ASI: ancho Descripción" "NUM" "")
      ("ASI_ANCHO_UNIDAD" "1.1700" "ASI: ancho Unidad" "NUM" "")
      ("ASI_ANCHO_PU" "1.7250" "ASI: ancho P.U." "NUM" "")
      ("ASI_ANCHO_CANTIDAD" "1.6997" "ASI: ancho Cantidad" "NUM" "")
      ("ASI_ANCHO_IMPORTE" "1.9849" "ASI: ancho Importe" "NUM" "")
      ("CSSA_ANCHO_TOTAL" "24.0964" "CSSA: ancho total de la tabla" "NUM" "")
      ("BACHEO_ESPESOR" "0.10" "Bacheo: espesor para volumen en EXR (m)" "NUM" "")
      ("TABLA_ULTIMO" "Obras" "MTABLA: último formato usado" "TXT" "")
      ("AREA_ULTIMO" "Prefijo" "MAREA: última opción usada" "TXT" "")
    ))

    ;; ¿Hay FAS compilados para ESTA versión?
    (defun memo:fas-vigente-p (/ f v)
      (if (and (setq f (findfile (strcat memo:dir-fas "version.txt")))
               (setq f (open f "r")))
        (progn (setq v (read-line f)) (close f) (= v memo:version))))
    (setq memo:usar-fas (memo:fas-vigente-p))

    ;; Ruta real a cargar (.fas compilado o .lsp)
    (defun memo:ruta (rel / fas)
      (setq fas (strcat memo:dir-fas (vl-filename-base rel) ".fas"))
      (if (and memo:usar-fas (findfile fas))
        fas
        (strcat memo:raiz "/LISP/" rel ".lsp")))

    ;; Carga el archivo real y ejecuta el comando solicitado
    (defun memo:cargar (rel cmd / ruta res)
      (setq ruta (memo:ruta rel))
      (cond
        ((member rel memo:archivos-cargados)
         (princ (strcat "\nMEMO: " rel " se cargó pero no define el comando " cmd)))
        ((not (findfile ruta))
         (princ (strcat "\nMEMO: no se encuentra " ruta)))
        (T
         (setq memo:archivos-cargados (cons rel memo:archivos-cargados))
         (setq res (vl-catch-all-apply 'load (list ruta)))
         (if (vl-catch-all-error-p res)
           (princ (strcat "\nMEMO: error al cargar " rel ": " (vl-catch-all-error-message res)))
           (eval (list (read (strcat "C:" cmd)))))))
      (princ))

    ;; Define los comandos de un archivo como stubs que lo cargan al primer uso
    (defun memo:al (rel cmds / sym)
      (setq memo:*mapa* (cons (list rel cmds) memo:*mapa*))
      (foreach cmd cmds
        (setq sym (read (strcat "C:" cmd)))
        ;; Si otro LISP cargado antes ya definía el comando, se reemplaza por
        ;; la versión MEMO (la que esperan los botones) y se avisa.
        (if (eval sym) (setq memo:*ya-definidos* (cons cmd memo:*ya-definidos*)))
        (eval (list 'defun sym nil (list 'memo:cargar rel cmd)))
        (setq memo:*stubs* (cons (cons cmd (vl-princ-to-string (eval sym))) memo:*stubs*))
        (setq memo:num-comandos (1+ memo:num-comandos))))

    ;; T si el comando todavía es el stub (su archivo no lo definió)
    (defun memo:es-stub-p (cmd / s)
      (and (setq s (assoc cmd memo:*stubs*))
           (= (cdr s) (vl-princ-to-string (eval (read (strcat "C:" cmd)))))))

    (if memo:raiz
      (progn
        ;; Biblioteca común (siempre)
        (if (vl-catch-all-error-p (vl-catch-all-apply 'load (list (memo:ruta "Sistema/MEMO_Lib"))))
          (princ "\nMEMO: no se pudo cargar la biblioteca MEMO_Lib."))
        (memo:al "Estimaciones/COP_ConceptosObrasPublicas" '("COP" "LIMPIARTABLA"))
        (memo:al "Estimaciones/ASI_ConceptosAsipona" '("ASI"))
        (memo:al "Estimaciones/CSSA_ConceptosSSA" '("LIMPIARCSSA" "CSSA"))
        (memo:al "Estimaciones/LC_LimpiarConceptos" '("LCO"))
        (memo:al "Estimaciones/CAS_CompAreaSecc" '("CAS" "QA"))
        (memo:al "Estimaciones/IJPG_CadAJpg" '("IJPG" "IJPG-EMF" "IJPG-PC3"))
        (memo:al "Bacheo/RS_RectanguloSnap" '("RS" "RSC" "AEC" "RC2" "RSHATCH" "RS-CONFIG"))
        (memo:al "Bacheo/RV_RenumerarRectangulos" '("RENUMERARVECINO" "RNB"))
        (memo:al "Bacheo/COTB_CotarBaches" '("COTB"))
        (memo:al "Bacheo/EXR_ExportaRectangulos" '("EXR" "VERLISTA" "VERXDATA" "AXD"))
        (memo:al "Bacheo/HR_HatchRectangulos" '("HR"))
        (memo:al "Bacheo/BTR_BorrarTextoEnRect" '("BTR"))
        (memo:al "Secciones/EL_Elevacion" '("ELTN"))
        (memo:al "Secciones/R00_CambiaNumeros" '("R00"))
        (memo:al "Secciones/AM2_AreaM2" '("AM2"))
        (memo:al "Secciones/HA_AreaPrefijo" '("HA2" "HA" "HAPREF" "HARESET" "HAINFO"))
        (memo:al "Secciones/AS_AreaSecc3P" '("AS"))
        (memo:al "Secciones/AC_AreaContorno" '("AC"))
        (memo:al "Secciones/AH_AreaHatch" '("AH2" "AH" "AHINFO"))
        (memo:al "Secciones/EA_ExportarEstArea" '("EA" "HAEA-EXPORT" "EA-HA" "HAEA"))
        (memo:al "Textos/CT_Toolbox" '("CTB" "CTE" "CTP" "IPT" "CTN" "STV"))
        (memo:al "Textos/CTT_CambiaTexto" '("CTX"))
        (memo:al "Textos/ALIT_AlinearTexto" '("ALIT"))
        (memo:al "Textos/PTE_Pendiente" '("PTE"))
        (memo:al "Textos/UL_MayMin" '("UL"))
        (memo:al "Textos/PS_PrefijoSufijo" '("PS" "PREFSUFIND" "VERPREFSUF" "LIMPIARPREFSUF" "SETPREFSUF"))
        (memo:al "Textos/RTT_RotarTexto" '("RTT"))
        (memo:al "Textos/ST_SumaTextos" '("ST" "ST-TEST"))
        (memo:al "Textos/CTAF_TextoAltoAncho" '("CTAF" "CTF" "CTAF2"))
        (memo:al "Textos/CORM_CoordenadasATexto" '("COR" "COR2" "CORM"))
        (memo:al "Hatch/SPH_SeparaFusionaHatch" '("SEPARAHATCH" "SPH" "FUSIONHATCH" "FH"))
        (memo:al "Hatch/CHS_HatchSimilar" '("CHS"))
        (memo:al "VistasLayout/CV_CrearVistas" '("CV"))
        (memo:al "VistasLayout/AV_GuardarRestaurarVistas" '("AV" "GV"))
        (memo:al "VistasLayout/BV_BorrarVistas" '("BV"))
        (memo:al "VistasLayout/CL_ClonarLayout" '("CLO"))
        (memo:al "VistasLayout/CFTL_ConfigurarLayouts" '("CFTL"))
        (memo:al "VistasLayout/SL_SuprimirLayouts" '("SL"))
        (memo:al "Topografia/ICE_ImportarPuntos" '("ICE"))
        (memo:al "Topografia/PCC_PuntosCivilACapas" '("PCC"))
        (memo:al "Topografia/UPP_UnirPuntosPol" '("UPP" "UPPA"))
        (memo:al "Topografia/MP_MallaPuntos" '("MALLA-PUNTOS" "EXPORTAR-PUNTOS" "MLL" "EXP"))
        (memo:al "Topografia/XY_ExportarCoordPol" '("X-Y"))
        (memo:al "Topografia/CPEC_ColorearPorElevacion" '("CPEC"))
        (memo:al "Topografia/CCN_CurvasNivel" '("CCN" "CCNT" "CCNAYUDA" "CCNTEST"))
        (memo:al "Topografia/ECN_ElevacionCurvas" '("ECN-DUPLICADOS" "ECN-P" "ECN-M" "ECN-ETIQ" "ECN-ETIQM" "ECN-QUITAR" "ECN-RECOLOR" "ECN-LIMPIA" "ECN-DESHACER" "ECN-LISTA" "ECN-CONFIG" "ETM" "ECN"))
        (memo:al "Topografia/BPOL_BorraPol" '("BPOL"))
        (memo:al "Topografia/CLIPIT" '("CLIPIT"))
        (memo:al "Batimetria/XYZ_Tools" '("XYZRESTAURAR" "XYZAYUDA" "XYZLOTES" "XYZBORRAR" "XYZ" "IXYZ" "PZ" "XYZUNIR" "P-Z" "IZ" "OZ" "ZM" "XYZU" "EXYZ" "XYZEXPORTAR" "XYZTEST"))
        (memo:al "Batimetria/PIT_PuntoInsTexto" '("PIT"))
        (memo:al "Batimetria/PERFIL_Transversal" '("PERFIL"))
        (memo:al "Bloques/IBC_BloquesEnCapa" '("IBC"))
        (memo:al "Bloques/IBCZ_BloquesEnCapaEscala" '("IBCZ" "ARBOLES" "RAP" "DES" "IBPV" "IBTM" "CFE" "VERBLOQUES" "VERCAPAS" "CONFIGESCALAS"))
        (memo:al "Bloques/IBM_BloquesMultiples" '("IBM"))
        (memo:al "Sistema/MEMO_Unificados" '("MTABLA" "MAREA" "MBACHEO" "MEMO_CONFIG"))
        (setq memo:*mapa* (reverse memo:*mapa*))
        (if memo:*ya-definidos*
          (progn
            (princ "\nMEMO: otro LISP cargado antes ya definía estos comandos; se usa la versión MEMO:")
            (princ "\n      ")
            (foreach c (reverse memo:*ya-definidos*) (princ (strcat c " ")))
            (princ "\n      (revise APPLOAD > Conjunto de inicio y quite los LISP viejos)")))
        (setq memo:cargado T)
        (princ (strcat "\nMEMO SISTEMA " memo:version " listo: " (itoa memo:num-comandos)
                       " comandos" (if memo:usar-fas " (compilados)" "")
                       ". Escriba MEMO_AYUDA para ver la lista.")))
      (princ "\nMEMO: no se encontró MEMO_Cargador.lsp en las rutas de soporte."))))

;;; ---------------------------------------------------------------------
;;; Comandos propios del sistema
